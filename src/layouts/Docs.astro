---
// Layout de la documentación del proyecto (/docs/). Interna: noindex, sin Nav, Footer, motion
// ni registro del service worker. Lee los tokens de marca de global.css.
import '../styles/global.css';
import { PAGINAS_DOCS } from '../data/docs/indice';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la página actual, para marcarla en el menú. */
  ruta: string;
}
const { titulo, descripcion, ruta } = Astro.props;
const grupos = ['Planeación', 'Análisis', 'Contexto'] as const;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo} | Documentación de Antídoto</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cal-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cab">
      <div class="cab-in">
        <a class="marca" href="/docs/">Documentación <span>Antídoto</span></a>
        <a class="volver" href="/">Ir al sitio</a>
      </div>
    </header>
    <div class="marco">
      <nav class="menu" aria-label="Documentación">
        <a class:list={['item', { actual: ruta === '/docs/' }]} href="/docs/" aria-current={ruta === '/docs/' ? 'page' : undefined}>Resumen</a>
        {grupos.map((g) => (
          <div class="grupo">
            <p class="grupo-t">{g}</p>
            {PAGINAS_DOCS.filter((p) => p.grupo === g).map((p) => (
              <a class:list={['item', { actual: ruta === p.ruta }]} href={p.ruta} aria-current={ruta === p.ruta ? 'page' : undefined}>{p.titulo}</a>
            ))}
          </div>
        ))}
      </nav>
      <main id="contenido" class="contenido">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .saltar { position: absolute; left: 16px; top: -60px; z-index: 60; background: var(--color-antidote); color: var(--color-ink); padding: 10px 14px; border-radius: 8px; font-weight: 600; text-decoration: none; }
  .saltar:focus { top: 8px; }

  .cab { border-bottom: 1px solid var(--color-line-soft); background: var(--color-paper); }
  .cab-in { max-width: 1200px; margin-inline: auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .marca { font-family: var(--font-display); font-size: 20px; color: var(--color-ink); text-decoration: none; }
  .marca span { color: var(--color-deep); }
  .volver { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--color-deep); text-decoration: none; }
  .volver:hover { background: var(--color-mist); }

  .marco { max-width: 1200px; margin-inline: auto; padding: 32px 24px 96px; display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; align-items: start; }
  .menu { position: sticky; top: 16px; display: flex; flex-direction: column; gap: 4px; }
  .grupo { margin-top: 16px; }
  .grupo-t { font: 600 11px/1.3 var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-slate); margin: 0 0 6px 12px; }
  .item { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 10px; font-size: 15px; color: var(--color-ink); text-decoration: none; }
  .item:hover { background: var(--color-mist); }
  .item.actual { background: rgb(59 200 243 / 0.18); font-weight: 600; }

  .contenido { min-width: 0; }
  .contenido h1 { font-size: clamp(32px, 4vw, 48px); line-height: 1.08; margin: 0 0 12px; color: var(--color-ink); }
  .contenido h2 { font-size: clamp(24px, 2.4vw, 30px); line-height: 1.15; margin: 56px 0 12px; color: var(--color-ink); }
  .contenido h3 { font-size: 20px; line-height: 1.25; margin: 0 0 8px; color: var(--color-ink); }
  .contenido p { margin: 0 0 14px; max-width: 70ch; }
  .lead { font-size: 19px; color: var(--color-slate); max-width: 62ch; margin-bottom: 28px; }
  .contenido a:not(.item):not(.tarjeta-link) { color: var(--color-deep); text-underline-offset: 3px; }
  .contenido code { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-mist); padding: 2px 6px; border-radius: 6px; word-break: break-word; }

  .chip { display: inline-flex; align-items: center; gap: 7px; font: 600 12px/1 var(--font-sans); padding: 6px 10px; border-radius: 999px; background: var(--color-mist); color: var(--color-ink); white-space: nowrap; }
  .chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--color-dash); }
  .chip.implementado::before { background: var(--color-antidote); }
  .chip.parcial::before { background: #e0a21a; }
  .chip.pendiente::before { background: var(--color-dash); }
  .chip.neutro::before { display: none; }

  .caja { background: var(--color-mist); border-radius: 16px; padding: 20px 22px; }
  .caja p:last-child { margin-bottom: 0; }

  .tabla-wrap { overflow-x: auto; border: 1px solid var(--color-line-soft); border-radius: 14px; }
  .tabla { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 640px; }
  .tabla th { text-align: left; font: 600 12px/1.3 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); background: var(--color-mist); padding: 12px 14px; }
  .tabla td { padding: 14px; vertical-align: top; border-top: 1px solid var(--color-line-soft); }
  .tabla td.id { font-family: var(--font-mono); font-size: 13px; white-space: nowrap; }

  .resumen { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 24px 0 8px; }
  .dato { background: var(--color-mist); border-radius: 14px; padding: 16px 18px; }
  .dato b { display: block; font-family: var(--font-display); font-weight: 400; font-size: 34px; line-height: 1; color: var(--color-ink); }
  .dato span { font-size: 13px; color: var(--color-slate); }

  @media (max-width: 900px) {
    .marco { grid-template-columns: 1fr; gap: 24px; padding-inline: 16px; }
    .cab-in { padding-inline: 16px; }
    .menu { position: static; flex-direction: row; flex-wrap: wrap; gap: 6px; }
    .grupo { display: contents; }
    .grupo-t { display: none; }
    .item { border: 1px solid var(--color-line-soft); }
  }
</style>
