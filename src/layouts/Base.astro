---
// Layout de todas las páginas. Sitio multipágina: cada navegación carga un documento
// nuevo y el paso lo animan las view transitions nativas declaradas en global.css.
import '../styles/global.css';
import Ambiente from '../components/Ambiente.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BarraWhatsapp from '../components/BarraWhatsapp.astro';
import Motion from '../components/Motion.astro';
import { t, otroIdioma, type Locale, type Pagina } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props {
  locale: Locale;
  /** Página del menú a marcar como actual (null en páginas fuera del menú). */
  pagina: Pagina | null;
  title: string;
  description: string;
  /** Rutas equivalentes en cada idioma, para hreflang y el selector de idioma. */
  alternates: Record<Locale, string>;
  /** Mensaje de WhatsApp del botón flotante (por defecto, el general). */
  waMessage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Sin URL propia (el 404 responde en cualquier ruta): sin canonical, hreflang ni og:url. */
  sinCanonical?: boolean;
  /** Scroll suave (Lenis) en páginas de marketing; las de lectura conservan el nativo. */
  scroll?: 'suave' | 'nativo';
  /** Claro: la home rediseñada, sin el fondo con brillos ni la barra de WhatsApp. */
  tema?: 'oscuro' | 'claro';
}
const { locale, pagina, title, description, alternates, waMessage, jsonLd, noindex = false, sinCanonical = false, scroll = 'nativo', tema = 'oscuro' } = Astro.props;
const claro = tema === 'claro';
const s = t(locale);
const canonical = new URL(alternates[locale], SITE.url).href;
const ogImage = new URL('/og/antidoto-og.jpg', SITE.url).href;
const otro = otroIdioma(locale);
---
<!doctype html>
<html lang={s.htmlLang} data-tema={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!sinCanonical && <link rel="canonical" href={canonical} />}
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    {!sinCanonical && (
      <>
        <link rel="alternate" hreflang="es-CO" href={new URL(alternates.es, SITE.url).href} />
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, SITE.url).href} />
      </>
    )}
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/cal-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={s.ogLocale} />
    <meta property="og:locale:alternate" content={t(otro).ogLocale} />
    {!sinCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={s.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={s.ogAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-scroll={scroll}>
    <a class="skip" href="#main">{s.skip}</a>
    {!claro && <Ambiente lado={pagina === 'nosotros' || pagina === 'contacto' ? 'izquierda' : 'derecha'} />}
    <Nav locale={locale} alternateHref={alternates[otro]} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} novedades={pagina !== 'inicio'} />
    {!claro && <BarraWhatsapp locale={locale} message={waMessage} />}
    <Motion />
  </body>
</html>

<script>
  import { registrarOrigen } from '../lib/origen';

  registrarOrigen();

  // PWA: el service worker (generado en el build desde src/pwa/sw.js) se registra después de
  // la carga para no competir con el LCP. En dev no se registra.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}), { once: true });
  }
</script>

<style>
  .skip { position: absolute; left: 16px; top: -60px; z-index: 60; background: var(--color-antidote); color: var(--color-ink); padding: 10px 14px; border-radius: 8px; font-weight: 600; text-decoration: none; }
  .skip:focus { top: 8px; }
</style>
