---
// Servicios en la home: cuatro tarjetas con foto real. Al apuntar o enfocar, el líquido de
// la marca sube desde el fondo de la foto (clip-path) y destapa los datos del servicio; es
// el mismo gesto del frasco que se llena. En táctil los datos se ven siempre.
import { Image } from 'astro:assets';
import { SERVICIOS, servicioPath } from '../data/servicios';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
---
<ul class="tarjetas">
  {SERVICIOS.map((sv, i) => {
    const txt = sv[locale];
    return (
      <li>
        <a class="tarjeta" href={servicioPath(sv, locale)}>
          <span class="foto">
            <Image src={sv.image} alt="" widths={[320, 480, 640]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 300px" loading="lazy" />
            <span class="liquido" aria-hidden="true">
              <svg class="ola" viewBox="0 0 240 16" preserveAspectRatio="none"><path d="M0 8 q15 -8 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 V16 H0Z" /></svg>
              <span class="datos">{txt.facts.map((f) => <span>{f}</span>)}</span>
            </span>
            <span class="num" aria-hidden="true">0{i + 1}</span>
            {sv.provisional && <span class="tag">{s.provisional}</span>}
          </span>
          <span class="nombre" style={`view-transition-name: servicio-${sv.id}-title`}>{txt.title}</span>
          <span class="desc">{txt.lead}</span>
          <span class="mas">{s.serviceMore} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .tarjetas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .tarjeta { display: flex; flex-direction: column; gap: 10px; height: 100%; text-decoration: none; color: var(--color-fg); }
  .foto { position: relative; aspect-ratio: 3 / 4; border-radius: 18px; overflow: hidden; background: var(--color-ink-raised); border: 1px solid rgb(128 220 255 / 0.12); }
  .foto img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-slow) var(--ease-out); }
  .tarjeta:hover .foto img, .tarjeta:focus-visible .foto img { transform: scale(1.05); }
  .num { position: absolute; top: 12px; left: 14px; font: 400 34px/1 var(--font-accent); color: var(--color-fg); text-shadow: 0 2px 12px rgb(0 0 0 / 0.5); }

  .tag { position: absolute; top: 14px; right: 12px; font: 600 10.5px/1 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; background: rgb(10 17 21 / 0.8); padding: 6px 8px; border-radius: 6px; }

  /* Líquido que sube: capa cian translúcida con una ola en el borde superior. */
  .liquido { position: absolute; left: 0; right: 0; bottom: 0; height: 52%; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; background: linear-gradient(180deg, rgb(28 153 202 / 0.82), rgb(12 92 125 / 0.94)); clip-path: inset(100% 0 0 0); transition: clip-path 0.6s var(--ease-out); }
  .ola { position: absolute; left: 0; right: 0; top: -15px; width: 100%; height: 16px; fill: rgb(28 153 202 / 0.82); }
  .tarjeta:hover .liquido, .tarjeta:focus-visible .liquido { clip-path: inset(-20px 0 0 0); }
  .datos { display: grid; gap: 4px; font-size: 13px; font-weight: 500; color: #fff; }
  .datos span::before { content: '· '; color: var(--color-glow); }

  .nombre { font: 400 22px/1.12 var(--font-display); letter-spacing: -0.01em; transition: color var(--t-base) var(--ease-out); }
  .tarjeta:hover .nombre { color: var(--color-antidote); }
  .desc { font-size: 14px; color: var(--color-fg-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .mas { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--color-antidote); }

  /* En táctil no hay hover: el líquido queda arriba con los datos a la vista. */
  @media (hover: none) { .liquido { clip-path: inset(-20px 0 0 0); height: 42%; } }
  @media (max-width: 1100px) { .tarjetas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .tarjetas { grid-template-columns: 1fr; } .foto { aspect-ratio: 16 / 11; } }
</style>
