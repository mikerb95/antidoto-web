---
// Barra inferior "Cotizar por WhatsApp" en móvil (brief §5, "Global móvil"): aparece al pasar
// la primera pantalla y se esconde sobre el pie de página. En escritorio no hace falta: el
// CTA "Cotizar" vive en la barra de navegación.
import WhatsappIcon from './WhatsappIcon.astro';
import { t, type Locale } from '../i18n/ui';
import { waLink } from '../data/site';

interface Props {
  locale: Locale;
  message?: string;
}
const { locale, message } = Astro.props;
const s = t(locale);
---
<div class="barra-wa" data-barra-wa>
  <a class="btn btn-primary" href={waLink(message ?? s.waDefault)} target="_blank" rel="noopener"><WhatsappIcon />{s.heroCta}</a>
</div>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra-wa]');
  const pie = document.querySelector('footer');
  if (barra) {
    let sobrePie = false;
    const actualizar = () => barra.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.6 && !sobrePie);
    if (pie) new IntersectionObserver(([e]) => { sobrePie = e.isIntersecting; actualizar(); }).observe(pie);
    addEventListener('scroll', actualizar, { passive: true });
    actualizar();
  }
</script>

<style>
  .barra-wa { display: none; }
  @media (max-width: 760px) {
    .barra-wa {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 35;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
      background: rgb(10 17 21 / 0.9); backdrop-filter: blur(12px); border-top: 1px solid var(--color-line);
      transform: translateY(110%); transition: transform var(--t-base) var(--ease-out);
      view-transition-name: barra-wa;
    }
    .barra-wa:global(.is-visible) { transform: none; }
    .barra-wa .btn { width: 100%; }
  }
</style>
