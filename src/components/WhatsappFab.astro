---
// Botón flotante de WhatsApp, presente en todas las páginas (como en codebymike.net).
import WhatsappIcon from './WhatsappIcon.astro';
import { t, type Locale } from '../i18n/ui';
import { waLink } from '../data/site';

interface Props {
  locale: Locale;
  message?: string;
}
const { locale, message } = Astro.props;
const s = t(locale);
---
<a class="fab" href={waLink(message ?? s.waDefault)} target="_blank" rel="noopener" aria-label={s.waFab}><WhatsappIcon /></a>

<style>
  .fab {
    position: fixed; right: 20px; bottom: calc(env(safe-area-inset-bottom, 0px) + 20px); z-index: 35;
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #fff; box-shadow: 0 10px 30px rgb(0 0 0 / 0.45), 0 0 0 6px rgb(37 211 102 / 0.14);
    view-transition-name: fab; transition: transform var(--t-base) var(--ease-out);
  }
  .fab:hover { transform: scale(1.06); }
  .fab :global(svg) { width: 28px; height: 28px; }
</style>
