---
// Tarjeta de los índices (servicios, ofertas, soluciones, casos, artículos). Toda la tarjeta es
// un enlace. Al apuntar o enfocar, el cian sube desde abajo como el líquido del frasco.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  titulo: string;
  texto?: string;
  /** Etiqueta pequeña arriba (p. ej. la línea o la fecha). */
  etiqueta?: string;
  cta?: string;
  imagen?: ImageMetadata;
  alt?: string;
  /** Nivel del título dentro de la página. */
  nivel?: 2 | 3;
  vt?: string;
}
const { href, titulo, texto, etiqueta, cta, imagen, alt = '', nivel = 3, vt } = Astro.props;
const H = `h${nivel}` as 'h2' | 'h3';
---
<a class:list={['tarjeta', { 'con-foto': imagen }]} href={href}>
  {imagen && (
    <span class="foto">
      <Image src={imagen} alt={alt} widths={[360, 560, 720]} sizes="(max-width: 700px) 100vw, 380px" />
    </span>
  )}
  <span class="cuerpo">
    {etiqueta && <span class="etiqueta">{etiqueta}</span>}
    <H class="t" style={vt ? `view-transition-name: ${vt}` : undefined}>{titulo}</H>
    {texto && <span class="d">{texto}</span>}
    {cta && <span class="cta">{cta}</span>}
  </span>
</a>

<style>
  .tarjeta { position: relative; isolation: isolate; overflow: hidden; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; border-radius: 20px; background: var(--color-paper); border: 1px solid var(--color-line-soft); box-shadow: 0 10px 30px rgb(15 24 29 / 0.05); text-decoration: none; color: var(--color-ink); transition: transform var(--t-base) var(--ease-out), box-shadow var(--t-base) var(--ease-out); }
  .tarjeta::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-antidote); clip-path: inset(100% 0 0 0); transition: clip-path var(--t-slow) var(--ease-in-out); }
  .tarjeta:hover, .tarjeta:focus-visible { transform: translateY(-4px); box-shadow: 0 18px 40px rgb(15 24 29 / 0.1); }
  .tarjeta:hover::before, .tarjeta:focus-visible::before { clip-path: inset(0 0 0 0); }
  .tarjeta:hover .d, .tarjeta:hover .cta, .tarjeta:hover .etiqueta, .tarjeta:focus-visible .d, .tarjeta:focus-visible .cta, .tarjeta:focus-visible .etiqueta { color: var(--color-ink); }
  .foto { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-ink); }
  .foto img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--t-slow) var(--ease-out); }
  .tarjeta:hover .foto img { transform: scale(1.04); }
  .cuerpo { display: flex; flex-direction: column; gap: 10px; padding: 24px; flex-grow: 1; }
  .etiqueta { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--color-deep); }
  .etiqueta::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--color-antidote); box-shadow: 0 0 0 3px rgb(59 200 243 / 0.2); }
  .t { margin: 0; font: 400 23px/1.2 var(--font-display); letter-spacing: -0.01em; }
  .d { color: var(--color-slate); font-size: 15.5px; line-height: 1.5; }
  .cta { margin-top: auto; padding-top: 6px; color: var(--color-deep); font-weight: 600; font-size: 15px; }
  .cta::after { content: '→'; margin-left: 0.35em; display: inline-block; transition: transform var(--t-base) var(--ease-out); }
  .tarjeta:hover .cta::after, .tarjeta:focus-visible .cta::after { transform: translateX(4px); }
</style>
