---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
---
<div class="wrap">
  <ul class="stats" data-cifras>
    {s.stats.map(([value, label]) => (
      <li><strong data-cifra>{value}</strong><span>{label}</span></li>
    ))}
  </ul>
</div>

<script>
  import { odometro } from '../lib/motion/cifras';

  const franja = document.querySelector<HTMLElement>('[data-cifras]');
  if (franja) odometro(franja);
</script>

<style>
  .stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; list-style: none; margin: 0; padding: 0; background: rgb(128 220 255 / 0.12); border: 1px solid rgb(128 220 255 / 0.12); border-radius: 16px; overflow: hidden; position: relative; z-index: 1; }
  li { background: rgb(10 17 21 / 0.72); padding: 18px 20px; backdrop-filter: blur(12px); }
  strong { display: block; font: 400 clamp(28px, 1.6vw + 14px, 38px) / 1.1 var(--font-accent); font-variant-numeric: tabular-nums; }
  li > span { font: 500 10.5px var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-fg-muted); }
  @media (max-width: 860px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li:last-child { grid-column: 1 / -1; }
  }
</style>
