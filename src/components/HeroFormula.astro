---
// Hero con el frasco del logotipo: fotos reales dentro del líquido, que sube al cargar.
import { getImage } from 'astro:assets';
import WhatsappIcon from './WhatsappIcon.astro';
import { WORDMARK_SIN_LIQUIDO, LIQUIDO } from '../data/logo';
import { t, homePath, type Locale } from '../i18n/ui';
import { waLink } from '../data/site';
import taller from '../assets/fotos/taller.jpg';
import grabacion from '../assets/fotos/grabacion.jpg';
import catering from '../assets/fotos/catering-buffet.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const [w1, c1, w2, c2, w3, c3] = s.heroTitle;

const fotos = await Promise.all(
  [taller, grabacion, catering].map((src) => getImage({ src, width: 360, height: 360, fit: 'cover', format: 'webp' })),
);
const { cx, cy, r } = LIQUIDO;
const box = { x: cx - r, y: cy - r, size: r * 2 };
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{s.heroEyebrow}</p>
      <h1 id="hero-title" data-titular>
        {w1}<span class="nw"><span class="tint">{c1}</span>{w2.trim()}</span>{' '}<span class="tint">{c2}</span>{w3}<span class="tint">{c3}</span>
      </h1>
      <p class="lead">{s.heroLead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={waLink(s.waDefault)} target="_blank" rel="noopener" data-magnetico><span class="btn-inner" data-magnetico-texto><WhatsappIcon />{s.heroCta}</span></a>
        <a class="btn btn-ghost" href={`${homePath[locale]}#servicios`}>{s.heroSecondary}</a>
      </div>
      <p class="sst"><i aria-hidden="true"></i>{s.heroSst}</p>
      <button class="pause-btn" type="button" aria-pressed="false" data-pause data-label-pause={s.pause} data-label-resume={s.resume}>{s.pause}</button>
    </div>
    <svg class="flask" viewBox="2812 780 418 540" role="img" aria-label={s.heroFlaskLabel}>
      <defs>
        <clipPath id="hero-liquid"><circle cx={cx} cy={cy} r={r} /></clipPath>
        <mask id="hero-level" maskUnits="userSpaceOnUse" x="2900" y="1000" width="240" height="240">
          <g class="rise"><path class="wave" fill="#fff" d="M2900 1062 q30 -9 60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 V1260 H2900Z" /></g>
        </mask>
        <filter id="hero-duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.06 0.5" />
            <feFuncG type="table" tableValues="0.16 0.86" />
            <feFuncB type="table" tableValues="0.22 1" />
          </feComponentTransfer>
        </filter>
      </defs>
      <g fill="currentColor" set:html={WORDMARK_SIN_LIQUIDO} />
      <g clip-path="url(#hero-liquid)">
        <g filter="url(#hero-duotone)" mask="url(#hero-level)">
          {fotos.map((f) => (
            <image class="clip" href={f.src} x={box.x} y={box.y} width={box.size} height={box.size} preserveAspectRatio="xMidYMid slice" />
          ))}
        </g>
        <g class="bubbles" fill="#80DCFF">
          <circle cx="2985" cy="1195" r="5" /><circle cx="3045" cy="1200" r="4" /><circle cx="3012" cy="1204" r="3" /><circle cx="3066" cy="1188" r="3.5" />
        </g>
      </g>
    </svg>
  </div>
</section>

<script>
  function init() {
    const btn = document.querySelector<HTMLButtonElement>('[data-hero] [data-pause]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!btn || !hero) return;
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? btn.dataset.labelResume! : btn.dataset.labelPause!;
      hero.classList.toggle('is-paused', paused);
    });
    // Los bucles se detienen fuera de pantalla.
    const io = new IntersectionObserver(([e]) => hero.classList.toggle('is-offscreen', !e.isIntersecting));
    io.observe(hero);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-block: 48px 0; background: radial-gradient(120% 90% at 85% 40%, #10303d 0%, var(--color-ink) 55%); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: end; }
  .copy { padding-bottom: 72px; }
  h1 { font-size: clamp(42px, 5vw + 6px, 84px); line-height: 1; margin-block: 16px 22px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .sst { display: inline-flex; gap: 10px; align-items: center; margin: 24px 0 0; font-size: 14px; color: var(--color-fg-muted); padding: 10px 14px; border: 1px solid var(--color-line); border-radius: 10px; }
  .sst i { width: 8px; height: 8px; border-radius: 50%; background: var(--color-antidote); flex: none; }
  .pause-btn { display: flex; margin-top: 16px; }
  .flask { display: block; width: 100%; height: auto; max-width: 600px; margin: 0 -40px -80px auto; color: var(--color-antidote); }

  /* La puntuación viaja con su palabra: SplitText la trata como palabra aparte y podría bajarla sola de línea. */
  .nw { white-space: nowrap; }
  .tint { animation: tint var(--t-slow) var(--ease-out) both; }
  .tint:nth-of-type(1) { animation-delay: 0.35s; }
  .tint:nth-of-type(2) { animation-delay: 0.6s; }
  .tint:nth-of-type(3) { animation-delay: 0.85s; }
  @keyframes tint { from { color: var(--color-fg); } to { color: var(--color-antidote); } }

  .rise { animation: rise 1.2s var(--ease-out) both 0.2s; }
  @keyframes rise { from { transform: translateY(160px); } }
  .wave { animation: wave 6s linear infinite; }
  @keyframes wave { to { transform: translateX(-120px); } }
  .bubbles circle { opacity: 0; animation: bubble 4.8s var(--ease-in-out) infinite; }
  .bubbles circle:nth-child(2) { animation-delay: 1.3s; }
  .bubbles circle:nth-child(3) { animation-delay: 2.6s; }
  .bubbles circle:nth-child(4) { animation-delay: 3.7s; }
  @keyframes bubble { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 0.9; } 100% { transform: translateY(-120px); opacity: 0; } }
  .clip { opacity: 0; animation: crossfade 12s linear infinite; }
  .clip:nth-of-type(2) { animation-delay: 4s; }
  .clip:nth-of-type(3) { animation-delay: 8s; }
  @keyframes crossfade { 0% { opacity: 0; } 6%, 33% { opacity: 1; } 40%, 100% { opacity: 0; } }
  .hero:global(.is-paused) :is(.wave, .bubbles circle, .clip),
  .hero:global(.is-offscreen) :is(.wave, .bubbles circle, .clip) { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .clip { opacity: 0; animation: none; }
    .clip:first-of-type { opacity: 1; }
    .bubbles { display: none; }
  }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .copy { padding-bottom: 8px; }
    .flask { max-width: 340px; margin: 16px auto -70px; }
  }
</style>
