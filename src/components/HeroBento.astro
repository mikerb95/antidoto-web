---
// Hero de la home como panel bento (la referencia es codebymike.net): titular a la
// izquierda y a la derecha tarjetas con información viva de la marca. La pieza grande es un
// visor de cámara con fotos reales de cada servicio, su ficha y el timecode; alrededor, la
// hora de Colombia, el frasco del logo como indicador y la tarjeta de cotización.
// Todo lo que muestra es real: servicios, cifras y fotos del sitio actual.
import { getImage } from 'astro:assets';
import WhatsappIcon from './WhatsappIcon.astro';
import { SERVICIOS } from '../data/servicios';
import { WORDMARK_SIN_LIQUIDO, LIQUIDO } from '../data/logo';
import { t, rutas, type Locale } from '../i18n/ui';
import { SITE, waLink } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const [w1, c1, w2, c2, w3, c3] = s.heroTitle;

const tomas = await Promise.all(
  SERVICIOS.map(async (sv, i) => ({
    img: await getImage({ src: sv.image, width: 960, height: 720, fit: 'cover', format: 'webp', quality: 76 }),
    ficha: `${s.visorFicha} 0${i + 1}`,
    nombre: sv[locale].title,
    alt: sv[locale].alt,
    provisional: !!sv.provisional,
  })),
);
const { cx, cy, r } = LIQUIDO;
---
<section class="hero" data-hud="base" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="estado mono"><span class="punto punto-vivo"></span>{s.estado} · {s.ubicacion} · {s.idiomas}</p>
      <ul class="insignias">
        {s.insignias.map((i) => <li class="panel"><span class="mono mono-acento">●</span>{i}</li>)}
      </ul>
      <h1 id="hero-title" data-titular>
        {w1}<span class="nw"><span class="texto-acento">{c1}</span>{w2.trim()}</span>{' '}<span class="texto-acento">{c2}</span>{w3}<span class="texto-acento">{c3}</span>
      </h1>
      <p class="lead">{s.heroLead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={waLink(s.waDefault)} target="_blank" rel="noopener" data-magnetico><span class="btn-inner" data-magnetico-texto><WhatsappIcon />{s.heroCta}</span></a>
        <a class="btn btn-ghost" href={rutas.servicios[locale]}>{s.heroSecondary} →</a>
      </div>
      <div class="stack">
        <p class="mono">{s.serviciosLabel}</p>
        <p class="lista">{s.serviciosCortos.join(' · ')}</p>
      </div>
    </div>

    <div class="bento">
      <figure class="visor panel" aria-label={s.visorLabel} data-visor>
        {tomas.map((tm, i) => (
          <img class:list={['toma', { activa: i === 0 }]} src={tm.img.src} width="960" height="720" alt={tm.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} data-toma data-ficha={tm.ficha} data-nombre={tm.nombre} data-provisional={tm.provisional ? s.provisional : ''} />
        ))}
        <div class="hud-visor" aria-hidden="true">
          <span class="esq tl"></span><span class="esq tr"></span><span class="esq bl"></span><span class="esq br"></span>
          <p class="arriba mono"><span data-ficha-texto>{tomas[0].ficha}</span><span data-contador>1/{tomas.length}</span></p>
          <p class="abajo mono"><span class="rec"><i></i>REC <span data-timecode>00:00:00:00</span></span><span data-nombre-texto>{tomas[0].nombre}</span></p>
          <div class="barras">{tomas.map((_, i) => <span class:list={{ llena: i === 0 }} data-barra></span>)}</div>
          <p class="provisional mono" data-provisional-texto hidden></p>
        </div>
        <button class="pausa" type="button" aria-pressed="false" data-visor-pausa data-label-pause={s.pause} data-label-resume={s.resume} aria-label={s.pause}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pausa" d="M8 5v14M16 5v14" /><path class="i-play" d="M7 5l12 7-12 7z" /></svg>
        </button>
      </figure>

      <div class="hora panel">
        <p class="mono">{s.horaLabel}</p>
        <p class="reloj" data-reloj>--:--:--</p>
        <p class="mono zona">{s.horaZona}</p>
      </div>

      <div class="dosis panel">
        <svg class="frasco" viewBox="2836 780 394 540" aria-hidden="true">
          <defs><clipPath id="dosis-liquido"><circle cx={cx} cy={cy} r={r} /></clipPath></defs>
          <g fill="currentColor" set:html={WORDMARK_SIN_LIQUIDO} />
          <g clip-path="url(#dosis-liquido)">
            <path class="ola" fill="#1C99CA" d="M2900 1080 q30 -12 60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 V1260 H2900Z" />
          </g>
        </svg>
        <div>
          <p class="mono">{s.dosisLabel}</p>
          <p class="dosis-t">{s.dosisTexto}</p>
        </div>
      </div>

      <a class="wa panel" href={waLink(s.waDefault)} target="_blank" rel="noopener">
        <span class="wa-ico"><WhatsappIcon /></span>
        <span class="wa-txt"><span class="mono">{s.waCardLabel}</span><span>{s.waCardTexto}</span></span>
        <span class="wa-num mono">{SITE.phoneDisplay} ↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { pieza, soloVisible } from '../lib/motion/core';

  // Hora de Colombia: la zona es fija (America/Bogota, GMT-5), sin depender de la del visitante.
  const reloj = document.querySelector<HTMLElement>('[data-reloj]');
  if (reloj) {
    const fmt = new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const tic = () => (reloj.textContent = fmt.format(new Date()));
    tic();
    setInterval(tic, 1000);
  }

  // Visor: cambia de toma cada 4 s con su ficha, contador y barras; el timecode corre a
  // 25 fps. Se detiene fuera de pantalla y tiene pausa visible (bucle de más de 5 s).
  const visor = document.querySelector<HTMLElement>('[data-visor]');
  if (visor) {
    pieza('visor', () => {
      const tomas = [...visor.querySelectorAll<HTMLImageElement>('[data-toma]')];
      const barras = [...visor.querySelectorAll<HTMLElement>('[data-barra]')];
      const ficha = visor.querySelector<HTMLElement>('[data-ficha-texto]')!;
      const nombre = visor.querySelector<HTMLElement>('[data-nombre-texto]')!;
      const contador = visor.querySelector<HTMLElement>('[data-contador]')!;
      const provisional = visor.querySelector<HTMLElement>('[data-provisional-texto]')!;
      const tc = visor.querySelector<HTMLElement>('[data-timecode]')!;
      const boton = visor.querySelector<HTMLButtonElement>('[data-visor-pausa]')!;
      let i = 0;
      let frames = 0;
      let corriendo = false;
      let pausadoPorUsuario = false;
      let reloj: number | undefined;
      const p = (n: number) => String(n).padStart(2, '0');

      const mostrar = (n: number) => {
        i = n;
        const tm = tomas[i];
        tomas.forEach((t, k) => t.classList.toggle('activa', k === i));
        barras.forEach((b, k) => b.classList.toggle('llena', k <= i));
        ficha.textContent = tm.dataset.ficha ?? '';
        nombre.textContent = tm.dataset.nombre ?? '';
        contador.textContent = `${i + 1}/${tomas.length}`;
        provisional.hidden = !tm.dataset.provisional;
        provisional.textContent = tm.dataset.provisional ?? '';
        frames = 0;
      };
      const paso = () => {
        frames++;
        tc.textContent = `00:00:${p(Math.floor(frames / 25) % 60)}:${p(frames % 25)}`;
        if (frames >= 100) mostrar((i + 1) % tomas.length);
      };
      const play = () => {
        if (corriendo || pausadoPorUsuario) return;
        corriendo = true;
        reloj = window.setInterval(paso, 40);
        visor.classList.remove('is-pausado');
      };
      const pause = () => {
        corriendo = false;
        window.clearInterval(reloj);
        visor.classList.add('is-pausado');
      };
      boton.addEventListener('click', () => {
        pausadoPorUsuario = !pausadoPorUsuario;
        boton.setAttribute('aria-pressed', String(pausadoPorUsuario));
        boton.setAttribute('aria-label', pausadoPorUsuario ? boton.dataset.labelResume! : boton.dataset.labelPause!);
        pausadoPorUsuario ? pause() : play();
      });
      soloVisible(visor, { play, pause });
    });
  }
</script>

<style>
  .hero { padding-block: 40px 32px; }
  .grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: 40px; align-items: center; }
  .estado { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; }
  .insignias { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0 0 22px; padding: 0; }
  .insignias li { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 10px; font-size: 13px; }
  h1 { font-size: clamp(40px, 3.9vw + 8px, 70px); line-height: 0.98; letter-spacing: -0.025em; margin: 0 0 22px; }
  .nw { white-space: nowrap; }
  .lead { margin: 0; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 26px; }
  .stack { margin-top: 26px; display: grid; gap: 4px; }
  .stack .mono { margin: 0; }
  .lista { margin: 0; font-size: 14px; }

  .bento { display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr); gap: 12px; }
  .visor { grid-column: 1; grid-row: 1 / 3; aspect-ratio: 4 / 3.35; overflow: hidden; margin: 0; }
  .toma { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; opacity: 0; transition: opacity 0.8s var(--ease-in-out); }
  .toma.activa { opacity: 1; }
  .visor::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(180deg, rgb(10 17 21 / 0.55), transparent 28%, transparent 62%, rgb(10 17 21 / 0.75)); pointer-events: none; }
  .hud-visor { position: absolute; inset: 14px; z-index: 1; pointer-events: none; }
  .esq { position: absolute; width: 18px; height: 18px; border: 2px solid var(--color-antidote); }
  .tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
  .tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
  .bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
  .br { bottom: 0; right: 0; border-left: 0; border-top: 0; }
  .arriba, .abajo { position: absolute; left: 28px; right: 28px; margin: 0; display: flex; justify-content: space-between; gap: 12px; color: var(--color-fg); }
  .arriba { top: 8px; }
  .abajo { bottom: 22px; }
  .rec { display: inline-flex; align-items: center; gap: 6px; }
  .rec i { width: 8px; height: 8px; border-radius: 50%; background: var(--color-reto); animation: latido 1s steps(1) infinite; }
  .visor:global(.is-pausado) .rec i { animation-play-state: paused; }
  .barras { position: absolute; left: 28px; right: 28px; bottom: 8px; display: flex; gap: 4px; }
  .barras span { flex: 1; height: 3px; border-radius: 2px; background: rgb(237 242 241 / 0.22); }
  .barras span.llena { background: var(--color-antidote); }
  .provisional { position: absolute; right: 28px; top: 34px; margin: 0; background: rgb(10 17 21 / 0.8); padding: 5px 8px; border-radius: 6px; }
  .pausa { position: absolute; z-index: 2; right: 14px; top: 50%; translate: 0 -50%; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(237 242 241 / 0.3); background: rgb(10 17 21 / 0.55); color: var(--color-fg); display: grid; place-items: center; cursor: pointer; opacity: 0; transition: opacity var(--t-base) var(--ease-out); }
  .visor:hover .pausa, .pausa:focus-visible, .pausa[aria-pressed='true'] { opacity: 1; }
  .pausa svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .pausa .i-play { display: none; fill: currentColor; stroke: none; }
  .pausa[aria-pressed='true'] .i-pausa { display: none; }
  .pausa[aria-pressed='true'] .i-play { display: block; }

  .hora, .dosis { padding: 16px; display: flex; flex-direction: column; justify-content: space-between; min-height: 0; }
  .hora .mono, .dosis .mono { margin: 0; }
  .reloj { margin: 6px 0; font: 400 clamp(26px, 1.6vw + 10px, 34px)/1 var(--font-accent); font-variant-numeric: tabular-nums; color: var(--color-fg); }
  .zona { color: var(--color-antidote) !important; }
  .dosis { gap: 10px; }
  .frasco { width: 56px; height: auto; flex: none; color: var(--color-antidote); }
  .ola { animation: ola 5s linear infinite; }
  @keyframes ola { to { transform: translateX(-120px); } }
  .dosis-t { margin: 4px 0 0; font-size: 14px; line-height: 1.35; }

  .wa { grid-column: 1 / -1; display: flex; align-items: center; gap: 14px; padding: 14px 16px; color: var(--color-fg); }
  .wa-ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: rgb(37 211 102 / 0.16); color: #25d366; flex: none; }
  .wa-ico :global(svg) { width: 22px; height: 22px; }
  .wa-txt { display: grid; gap: 2px; font-size: 14px; }
  .wa-txt .mono { color: var(--color-antidote); }
  .wa-num { margin-left: auto; color: var(--color-fg) !important; white-space: nowrap; }

  @media (max-width: 1020px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .visor { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 4 / 3.6; }
    .wa-num { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .ola { animation: none; } .rec i { animation: none; } }
</style>
