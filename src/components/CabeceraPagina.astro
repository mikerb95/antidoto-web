---
// Cabecera común de las páginas internas (diseño claro): migas, h1 con la palabra resaltada,
// lead, botones (slot) y, si hay, una foto a la derecha. Es el único h1 de la página.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Migas from './Migas.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  migas: Array<[string, string]>;
  /** Texto del h1: [antes, resaltado] o un texto plano. */
  titulo: readonly [string, string] | string;
  lead?: string;
  /** Etiqueta pequeña sobre el título. */
  kicker?: string;
  imagen?: ImageMetadata;
  alt?: string;
  /** view-transition-name del h1 (títulos compartidos entre páginas). */
  vt?: string;
}
const { locale, migas, titulo, lead, kicker, imagen, alt = '', vt } = Astro.props;
const [antes, resaltado] = typeof titulo === 'string' ? [titulo, ''] : titulo;
---
<header class:list={['cabecera', { 'con-foto': imagen }]}>
  <div class="wrap interior">
    <div class="texto">
      <Migas locale={locale} migas={migas} />
      {kicker && <p class="kicker">{kicker}</p>}
      <h1 data-titular style={vt ? `view-transition-name: ${vt}` : undefined}>{antes}{resaltado && <span class="resaltado">{resaltado}</span>}</h1>
      {lead && <p class="lead-claro">{lead}</p>}
      {Astro.slots.has('default') && <div class="acciones"><slot /></div>}
      <slot name="pie" />
    </div>
    {imagen && (
      <div class="foto" data-paralaje>
        <Image src={imagen} alt={alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</header>

<style>
  .cabecera { background: var(--color-mist); border-bottom: 1px solid var(--color-line-soft); }
  .interior { padding-block: 24px 64px; display: grid; gap: 40px; align-items: center; }
  .con-foto .interior { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  .texto { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .kicker { margin: 8px 0 0; font-size: 14px; font-weight: 600; color: var(--color-deep); letter-spacing: 0.04em; }
  h1 { margin: 8px 0 0; font-size: clamp(38px, 4.4vw + 8px, 64px); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; }
  h1 .resaltado { white-space: normal; }
  .lead-claro { margin: 0; max-width: 36em; font-size: clamp(17px, 0.6vw + 14px, 20px); color: var(--color-slate); }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .foto { position: relative; aspect-ratio: 5 / 4; border-radius: 22px; overflow: hidden; background: var(--color-ink); box-shadow: 0 20px 50px rgb(15 24 29 / 0.12); }
  .foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 900px) {
    .con-foto .interior { grid-template-columns: 1fr; }
    .interior { padding-bottom: 48px; gap: 28px; }
  }
</style>
