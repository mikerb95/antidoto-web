---
// Trivia de ejemplo, la pieza central del hero ("Juega primero"). Sin JS es una pantalla quieta
// con la respuesta marcada; el script la vuelve jugable. El reloj arranca cuando la persona ya
// interactuó con la página (no corre mientras alguien todavía lee el titular). Al responder se
// marcan la correcta y la elegida y, un momento después, el líquido llena la tarjeta con el
// resultado y la invitación a cotizar. Es ilustrativa y lo dice: la real sale de la biblioteca.
import { PUESTO_INICIAL, CORRECTA } from '../../lib/trivia';
import { t, rutas, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale).inicio.actividades.trivia;
const textos = {
  posicion: tr.posicion,
  acierto: [tr.tituloAcierto, tr.detalleAcierto],
  fallo: [tr.tituloFallo, tr.detalleFallo],
  tiempo: [tr.tituloTiempo, tr.detalleFallo],
};
---
<figure class="pantalla" id="trivia" aria-labelledby="trivia-pregunta" data-trivia data-textos={JSON.stringify(textos)}>
  <div class="fila"><span>{tr.progreso}</span><span class="tiempo" data-reloj>{tr.tiempo}</span></div>
  <div class="barra" aria-hidden="true"><span data-barra></span></div>
  <p class="pregunta" id="trivia-pregunta">{tr.pregunta}</p>
  <ol class="opciones">
    {tr.opciones.map((o, i) => (
      <li class:list={{ elegida: i === CORRECTA }} data-opcion>
        {o}{i === CORRECTA && <span class="sr" data-sr> ({tr.elegida})</span>}
      </li>
    ))}
  </ol>
  <p class="instruccion" hidden data-instruccion>{tr.instruccion}</p>
  <div class="fila pie"><span>{tr.conectados}</span><strong data-puesto>{tr.posicion.replace('{p}', String(PUESTO_INICIAL))}</strong></div>

  <div class="final" hidden tabindex="-1" aria-labelledby="trivia-final-t" role="group" data-final>
    <p class="f-titulo" id="trivia-final-t" data-f-titulo></p>
    <p class="f-detalle" data-f-detalle></p>
    <p class="f-remate">{tr.remate}</p>
    <div class="f-ctas">
      <a class="boton boton-tinta" href={rutas.contacto[locale]}>{tr.cotizar}</a>
      <button class="boton boton-borde" type="button" data-otra>{tr.otraVez}</button>
    </div>
  </div>
</figure>

<script>
  import { CORRECTA, DURACION, elegir, inicial, reloj, tic, type Estado } from '../../lib/trivia';
  import { llenar } from '../../lib/motion/llenar';
  import { reducido } from '../../lib/motion/core';

  // No es movimiento decorativo: corre también con movimiento reducido (sin el llenado animado).
  const fig = document.querySelector<HTMLElement>('[data-trivia]');
  if (fig) {
    try {
      type Par = [string, string];
      const txt = JSON.parse(fig.dataset.textos ?? '{}') as { posicion: string; acierto: Par; fallo: Par; tiempo: Par };
      const relojEl = fig.querySelector<HTMLElement>('[data-reloj]')!;
      const barra = fig.querySelector<HTMLElement>('[data-barra]')!;
      const instruccion = fig.querySelector<HTMLElement>('[data-instruccion]')!;
      const puesto = fig.querySelector<HTMLElement>('[data-puesto]')!;
      const final = fig.querySelector<HTMLElement>('[data-final]')!;
      const fTitulo = fig.querySelector<HTMLElement>('[data-f-titulo]')!;
      const fDetalle = fig.querySelector<HTMLElement>('[data-f-detalle]')!;
      const otra = fig.querySelector<HTMLButtonElement>('[data-otra]')!;

      let estado: Estado = inicial();
      let visible = false;
      let interactuo = false;
      let reloj_: number | undefined;
      let aviso: number | undefined;

      // Cada opción pasa a ser un botón real.
      const botones = [...fig.querySelectorAll<HTMLLIElement>('[data-opcion]')].map((li, i) => {
        li.querySelector('[data-sr]')?.remove();
        li.classList.remove('elegida');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'opcion';
        b.textContent = li.textContent?.trim() ?? '';
        li.textContent = '';
        li.appendChild(b);
        b.addEventListener('click', () => pintar(elegir(estado, i)));
        return b;
      });

      function mostrarFinal() {
        const [titulo, detalle] = txt[estado.fase as 'acierto' | 'fallo' | 'tiempo'];
        fTitulo.textContent = titulo;
        // Mínimo 1 s: quien responde antes de que arranque el reloj no lee "0 s".
        fDetalle.textContent = detalle.replace('{p}', String(estado.puesto)).replace('{s}', String(Math.max(1, DURACION - estado.restante)));
        final.hidden = false;
        final.focus({ preventScroll: true });
        if (!reducido()) llenar(final, { duracion: 0.9 });
      }

      function pintar(nuevo: Estado) {
        const antes = estado;
        estado = nuevo;
        const terminado = estado.fase !== 'jugando';
        relojEl.textContent = reloj(estado.restante);
        barra.style.transform = `scaleX(${estado.restante / DURACION})`;
        fig!.dataset.fase = estado.fase;
        botones.forEach((b, i) => {
          b.disabled = terminado;
          b.classList.toggle('correcta', terminado && i === CORRECTA);
          b.classList.toggle('incorrecta', terminado && i === estado.elegida && i !== CORRECTA);
        });
        puesto.textContent = txt.posicion.replace('{p}', String(estado.puesto));
        if (estado.puesto !== antes.puesto) {
          puesto.classList.remove('cambio');
          void puesto.offsetWidth;
          puesto.classList.add('cambio');
        }
        // Primero se ve qué opción era la correcta; después llega el resultado.
        if (terminado && antes.fase === 'jugando') aviso = window.setTimeout(mostrarFinal, reducido() ? 400 : 1100);
        actualizarReloj();
      }

      function actualizarReloj() {
        const correr = visible && interactuo && !document.hidden && estado.fase === 'jugando';
        if (correr && reloj_ === undefined) reloj_ = window.setInterval(() => pintar(tic(estado)), 1000);
        if (!correr && reloj_ !== undefined) {
          clearInterval(reloj_);
          reloj_ = undefined;
        }
      }

      otra.addEventListener('click', () => {
        clearTimeout(aviso);
        final.hidden = true;
        final.style.clipPath = '';
        pintar(inicial());
        botones[0].focus();
      });

      // El reloj espera a que la persona haga algo en la página.
      const despertar = () => {
        if (interactuo) return;
        interactuo = true;
        actualizarReloj();
      };
      for (const ev of ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll']) addEventListener(ev, despertar, { once: true, passive: true });

      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        actualizarReloj();
      }, { threshold: 0.5 }).observe(fig);
      document.addEventListener('visibilitychange', actualizarReloj);

      instruccion.hidden = false;
      fig.classList.add('jugable');
      pintar(estado);
    } catch (err) {
      console.warn('[trivia] queda como imagen quieta', err);
    }
  }
</script>

<style>
  .pantalla { position: relative; overflow: hidden; margin: 0; width: 100%; max-width: 460px; border-radius: 28px; background: var(--color-paper); color: var(--color-ink); padding: 26px; display: flex; flex-direction: column; gap: 14px; border: 1px solid var(--color-line-soft); box-shadow: 0 30px 70px rgb(15 24 29 / 0.16), 0 6px 18px rgb(15 24 29 / 0.06); scroll-margin-top: 24px; }
  .pantalla :focus-visible { outline-color: var(--color-deep); }
  .fila { display: flex; justify-content: space-between; align-items: center; font-size: 14px; font-weight: 600; }
  .tiempo { padding: 4px 10px; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-variant-numeric: tabular-nums; }
  .pantalla[data-fase='jugando'] .tiempo { background: var(--color-deep); }
  .barra { height: 8px; border-radius: 999px; background: var(--color-line-soft); overflow: hidden; }
  .barra span { display: block; width: 62%; height: 100%; background: var(--color-antidote); transform-origin: left; }
  .jugable .barra span { width: 100%; transition: transform 1s linear; }
  .pregunta { margin: 0; font: 400 23px/1.25 var(--font-display); }
  .opciones { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .opciones li { display: flex; align-items: center; min-height: 50px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--color-line-input); background: var(--color-paper); font-size: 15px; font-weight: 500; line-height: 1.3; }
  .opciones .elegida { border-color: var(--color-ink); background: var(--color-antidote); font-weight: 600; }
  /* Jugable: el <li> queda de contenedor y el botón toma su aspecto. */
  .jugable .opciones li { display: block; min-height: 0; padding: 0; border: 0; background: none; }
  .opciones :global(.opcion) { position: relative; isolation: isolate; overflow: hidden; width: 100%; min-height: 50px; padding: 8px 16px; border-radius: 12px; border: 1.5px solid var(--color-line-input); background: var(--color-paper); color: var(--color-ink); font: 500 15px/1.3 var(--font-sans); text-align: left; cursor: pointer; transition: border-color var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
  .opciones :global(.opcion:hover:not(:disabled)) { border-color: var(--color-ink); transform: translateY(-1px); }
  .opciones :global(.opcion:disabled) { cursor: default; }
  /* La correcta recibe la dosis: el cian sube desde abajo. */
  .opciones :global(.opcion)::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-antidote); clip-path: inset(100% 0 0 0); transition: clip-path var(--t-slow) var(--ease-in-out); }
  .opciones :global(.opcion.correcta) { border-color: var(--color-ink); font-weight: 600; }
  .opciones :global(.opcion.correcta)::before { clip-path: inset(0 0 0 0); }
  .opciones :global(.opcion.correcta)::after { content: ' ✓'; }
  .opciones :global(.opcion.incorrecta) { border-color: var(--color-reto); text-decoration: line-through; text-decoration-color: var(--color-reto); }
  .instruccion { margin: 0; font-size: 14px; color: var(--color-slate); }
  .instruccion[hidden] { display: none; }
  .pie { color: var(--color-slate); font-weight: 400; }
  .pie strong { display: inline-block; color: var(--color-ink); font-weight: 600; }
  .pie strong:global(.cambio) { animation: puesto var(--t-slow) var(--ease-out); color: var(--color-deep); }
  @keyframes puesto { from { transform: translateY(8px); opacity: 0; } }

  /* Resultado: el líquido llena la tarjeta y deja la invitación a cotizar. */
  .final { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 32px; background: var(--color-antidote); color: var(--color-ink); }
  .final[hidden] { display: none; }
  .final:focus { outline: none; }
  .final :focus-visible { outline-color: var(--color-ink); }
  .f-titulo { margin: 0; font: 400 clamp(34px, 3vw + 14px, 48px)/1.05 var(--font-display); }
  .f-detalle { margin: 0; font-size: 17px; font-weight: 500; }
  .f-remate { margin: 8px 0 0; font-size: 16px; }
  .f-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
