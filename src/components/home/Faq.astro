---
// Preguntas frecuentes destacadas (src/data/faq.ts) con <details> nativo, la primera abierta, y
// el enlace a la página con todas.
import ListaFaq from '../ListaFaq.astro';
import { preguntas } from '../../data/faq';
import { t, rutas, type Locale } from '../../i18n/ui';
import { tp } from '../../i18n/paginas';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const h = t(locale).inicio.faq;
---
<section class="faq" aria-labelledby="faq-t">
  <div class="interior">
    <h2 id="faq-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
    <ListaFaq items={preguntas(locale, { destacadas: true })} abrirPrimera />
    <a class="ver-todo" href={rutas.faq[locale]}>{tp(locale).faq.todas}</a>
  </div>
</section>

<style>
  .faq { background: var(--color-paper); }
  .interior { max-width: 860px; margin: 0 auto; padding: 80px 24px; display: flex; flex-direction: column; gap: 28px; }
  @media (max-width: 600px) { .interior { padding-inline: 16px; } }
  .titulo-seccion { text-align: center; }
  .interior :global(details) { background: var(--color-mist); }
</style>
