---
// Dolores del comprador: tarjetas en blanco y negro que al pasar el cursor (o con el foco)
// toman color con un tinte cian y cambian el texto del dolor por el de la solución.
// Encima de la foto a color va la misma foto en gris (el navegador la descarga una vez); la dosis
// la recorta de abajo arriba con clip-path, como el líquido que sube. En táctil, el script pone
// la clase .dosis cuando la tarjeta cruza el centro de la pantalla (src/lib/motion/inicio.ts).
import { Image } from 'astro:assets';
import sala from '../../assets/fotos/sala-taller.jpg';
import taller from '../../assets/fotos/taller.jpg';
import grabacion from '../../assets/fotos/grabacion.jpg';
import equipo from '../../assets/fotos/equipo-maqueta.jpg';
import grupo from '../../assets/fotos/grupo-aire-libre.jpg';
import mesa from '../../assets/fotos/mesa-evento.jpg';
import { t, rutas, type Locale } from '../../i18n/ui';
import { obtenerServicios, servicioPath } from '../../data/servicios';
import { obtenerOfertas, ofertaPath } from '../../data/contenido';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const h = t(locale).inicio.dolores;
// Destino de cada tarjeta: la oferta o la línea que resuelve ese dolor (clave de oferta, o
// "linea:<clave>"), o un ancla de la home. Si la oferta o la línea no se publica, va a Servicios.
const servicios = await obtenerServicios();
const ofertas = await obtenerOfertas();
const destinoDe = (d: string) => {
  if (d.startsWith('#')) return d;
  const [tipo, clave] = d.includes(':') ? d.split(':') : ['oferta', d];
  if (tipo === 'linea') {
    const sv = servicios.find((x) => x.id === clave);
    return sv ? servicioPath(sv, locale) : rutas.servicios[locale];
  }
  const o = ofertas.find((x) => x.id === clave);
  const sv = o && servicios.find((x) => x.id === o.linea);
  return o && sv ? ofertaPath(sv, o, locale) : rutas.servicios[locale];
};
// Foto, encuadre y destino de cada tarjeta, en el orden de los textos.
const FOTOS = [
  [sala, 'center', destinoDe('induccion')],
  [taller, 'center 25%', destinoDe('linea:formaciones')],
  [grabacion, 'center 40%', destinoDe('emergencias')],
  [equipo, 'center 35%', '#actividades'],
  [grupo, 'center 60%', destinoDe('equipos')],
  [mesa, 'center', rutas.servicios[locale]],
] as const;
---
<section class="dolores" aria-labelledby="dolores-t">
  <div class="wrap interior">
    <div class="cab-seccion">
      <h2 id="dolores-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
      <p><span class="con-cursor">{h.lead}</span><span class="tactil">{h.leadTactil}</span></p>
    </div>
    <div class="rejilla">
      {h.items.map(([dolor, solucion], i) => {
        const [foto, posicion, destino] = FOTOS[i];
        return (
          <a class="dolor" href={destino} data-paralaje>
            <Image src={foto} alt="" widths={[400, 640, 800]} sizes="(max-width: 720px) 100vw, 380px" style={`object-position: ${posicion}`} />
            <Image class="gris" src={foto} alt="" widths={[400, 640, 800]} sizes="(max-width: 720px) 100vw, 380px" style={`object-position: ${posicion}`} />
            <span class="tinte" aria-hidden="true"></span>
            <span class="chip"><span class="pain">{dolor}</span><span class="sol">{solucion}</span></span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .dolores { background: var(--color-mist); }
  .interior { padding-block: 80px; display: flex; flex-direction: column; gap: 36px; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 22px; }

  .dolor { position: relative; display: block; height: 210px; border-radius: 20px; overflow: hidden; text-decoration: none; background: var(--color-ink); isolation: isolate; }
  .dolor img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dolor .gris { filter: grayscale(1) contrast(1.05); clip-path: inset(0 0 0 0); transition: clip-path var(--t-slow) var(--ease-in-out); }
  .tinte { position: absolute; inset: 0; background: var(--color-antidote); mix-blend-mode: multiply; opacity: 0; transition: opacity var(--t-base) var(--ease-out); }
  .chip { position: absolute; left: 16px; bottom: 16px; max-width: 78%; padding: 10px 14px; border-radius: 12px; background: var(--color-paper); color: var(--color-ink); font-weight: 600; font-size: 16px; line-height: 1.3; isolation: isolate; }
  .chip::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--color-antidote); clip-path: inset(100% 0 0 0); transition: clip-path var(--t-slow) var(--ease-in-out); }
  .sol { display: none; }
  /* La indicación depende del dispositivo: sin cursor, la dosis llega al cruzar el centro. */
  .tactil { display: none; }
  @media (hover: none) { .con-cursor { display: none; } .tactil { display: inline; } }

  .dolor:hover .pain, .dolor:focus-visible .pain, .dolor:global(.dosis) .pain { display: none; }
  .dolor:hover .sol, .dolor:focus-visible .sol, .dolor:global(.dosis) .sol { display: inline; }
  .dolor:hover :global(.gris), .dolor:focus-visible :global(.gris), .dolor:global(.dosis) :global(.gris) { clip-path: inset(0 0 100% 0); }
  .dolor:hover .tinte, .dolor:focus-visible .tinte, .dolor:global(.dosis) .tinte { opacity: 0.38; }
  .dolor:hover .chip::before, .dolor:focus-visible .chip::before, .dolor:global(.dosis) .chip::before { clip-path: inset(0 0 0 0); }
</style>
