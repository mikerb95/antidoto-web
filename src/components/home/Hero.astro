---
// Hero: foto a pantalla completa con velo tinta, insignia de la licencia de SST, titular con
// palabra resaltada, dos llamadas, la fundadora y el espacio reservado para el reel.
import { Image } from 'astro:assets';
import foto from '../../assets/fotos/formacion-bandera.jpg';
import { obtenerServicios } from '../../data/servicios';
import { t, rutas, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio;
const alt = (await obtenerServicios()).find((sv) => sv.id === 'formaciones')![locale].alt;
---
<section id="inicio" class="hero" aria-labelledby="hero-t" data-hero>
  <Image class="foto" src={foto} alt={alt} widths={[640, 960, 1280]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="velo" aria-hidden="true"></div>
  <div class="centro wrap">
    <p class="insignia" data-hero-entra>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
      <span>{h.insignia}</span>
    </p>
    <h1 id="hero-t">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h1>
    <p class="lead" data-hero-entra>{h.lead}</p>
    <div class="ctas" data-hero-entra>
      <a class="boton boton-cian boton-grande" href={rutas.contacto[locale]} data-magnetico>
        {h.cotizar}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="boton boton-borde boton-grande claro" href="#actividades" data-magnetico>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
        {h.probar}
      </a>
    </div>
  </div>
  <div class="pie wrap" data-hero-entra>
    <div class="fundadora">
      <span class="monograma" aria-hidden="true">MP</span>
      <p><strong>{s.fundadoraNombre}</strong><span>{h.fundadoraResumen}</span></p>
    </div>
    <p class="reel">{h.reel}</p>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 640px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; background: var(--color-ink); color: var(--color-paper); }
  .foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .velo { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(15 24 29 / 0.62) 0%, rgb(15 24 29 / 0.78) 60%, rgb(15 24 29 / 0.94) 100%); }
  .centro { position: relative; padding-block: 72px 40px; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  .insignia { margin: 0; display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 999px; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.28); font-size: 14px; font-weight: 500; }
  .insignia svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--color-glow); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  h1 { margin: 0; max-width: 900px; font-size: clamp(38px, 5.2vw, 68px); line-height: 1.08; color: var(--color-paper); }
  h1 .resaltado { padding: 0 14px; }
  .lead { margin: 0; max-width: 680px; color: var(--color-fg-soft); font-size: 19px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .claro { color: var(--color-paper); }
  .ctas :focus-visible { outline-color: var(--color-antidote); }

  .pie { position: relative; padding-bottom: 36px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .fundadora { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 16px; background: rgb(15 24 29 / 0.72); border: 1px solid rgb(255 255 255 / 0.18); }
  .monograma { width: 52px; height: 52px; flex: none; border-radius: 50%; background: var(--color-deep); display: flex; align-items: center; justify-content: center; font: 400 20px/1 var(--font-display); }
  .fundadora p { margin: 0; display: flex; flex-direction: column; text-align: left; }
  .fundadora strong { color: var(--color-glow); font-weight: 600; font-size: 16px; }
  .fundadora span { color: var(--color-fg-soft); font-size: 14px; }
  .reel { margin: 0; padding: 10px 14px; border-radius: 10px; border: 1px dashed rgb(255 255 255 / 0.6); font-size: 13px; font-weight: 500; }
</style>
