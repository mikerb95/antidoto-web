---
// Equipo: tarjeta destacada de la fundadora, espacios para el equipo y la licencia de SST.
import { SITE } from '../../data/site';
import { t, rutas, type Locale } from '../../i18n/ui';
import { tp } from '../../i18n/paginas';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio.equipo;
---
<section id="nosotros" class="equipo" aria-labelledby="nosotros-t">
  <div class="wrap interior">
    <div class="cab-seccion">
      <h2 id="nosotros-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
      <p class="lead">{h.lead}</p>
    </div>
    <div class="fila" data-entra>
      <article class="fundadora">
        <div class="datos">
          <h3>{s.fundadoraNombre}</h3>
          <p class="cargo">{s.fundadoraCargo}</p>
          <ul>{h.credenciales.map((c) => <li>{c}</li>)}</ul>
          <a class="linkedin" href={SITE.linkedin} target="_blank" rel="noopener" aria-label={h.linkedin}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="5" cy="4.6" r="2.3" /><path d="M3 9h4v12H3zM10 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21H10z" /></svg>
          </a>
        </div>
        <p class="foto">{h.foto}</p>
      </article>
      <p class="pendiente integrante">{h.integrante}</p>
      <p class="pendiente integrante">{h.integrante}</p>
    </div>
    <div class="licencia">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
      <p><strong>{h.licencia}</strong><span>{h.licenciaDatos}</span></p>
    </div>
    <a class="ver-todo" href={rutas.nosotros[locale]}>{tp(locale).nosotros.seguir.join('')}</a>
  </div>
</section>

<style>
  .equipo { background: var(--color-mist); }
  .interior { padding-block: 80px; display: flex; flex-direction: column; gap: 36px; }
  .cab-seccion .lead { max-width: 620px; font-size: clamp(17px, 1.2vw + 10px, 20px); }
  .fila { display: flex; flex-wrap: wrap; align-items: stretch; gap: 22px; }

  .fundadora { flex: 2 1 600px; min-width: 0; display: flex; flex-wrap: wrap; gap: 24px; padding: 30px; border-radius: 24px; background: var(--color-antidote); color: var(--color-ink); }
  .datos { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  h3 { margin: 0; font-size: 36px; line-height: 1.1; }
  .cargo { margin: 0; font-style: italic; font-size: 17px; }
  ul { margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 16px; font-weight: 500; }
  li { display: flex; gap: 10px; align-items: center; }
  li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--color-ink); flex: none; }
  .linkedin { margin-top: auto; width: 46px; height: 46px; border-radius: 50%; background: var(--color-ink); color: var(--color-paper); display: inline-flex; align-items: center; justify-content: center; }
  .linkedin svg { fill: currentColor; }
  .foto { margin: 0; flex: 0 1 220px; min-width: 180px; min-height: 260px; border-radius: 18px; border: 2px dashed var(--color-ink); display: flex; align-items: center; justify-content: center; padding: 18px; box-sizing: border-box; text-align: center; font-size: 14px; font-weight: 500; }
  .fundadora :focus-visible { outline-color: var(--color-ink); }

  .integrante { margin: 0; flex: 1 1 220px; min-width: 0; min-height: 200px; border-radius: 24px; background: var(--color-paper); box-sizing: border-box; }

  .licencia { display: flex; gap: 16px; align-items: flex-start; padding: 20px 22px; border-radius: 18px; background: var(--color-paper); border: 1px solid var(--color-line-soft); }
  .licencia svg { width: 34px; height: 34px; flex: none; fill: none; stroke: var(--color-deep); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .licencia p { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .licencia strong { font-weight: 600; }
  .licencia span { color: var(--color-slate); font-size: 15px; }
</style>
