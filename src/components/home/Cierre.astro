---
// Cierre con cotización: el botón lleva al cotizador y el teléfono llama directo.
// El borde superior es oleaje: dos olas que se desplazan a distinta velocidad y en sentido
// contrario (src/lib/motion/inicio.ts). Es un bucle: tiene botón de pausa y se detiene fuera
// de pantalla. Sin JS o con movimiento reducido, las olas quedan quietas.
import { SITE } from '../../data/site';
import { t, rutas, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio.cierre;
// Ola periódica de 2880 de ancho (el SVG mide el doble de la pantalla): con un periodo que
// divide 1440, desplazar la mitad deja el dibujo calzado consigo mismo y el bucle no tiene costura.
// Cada medio periodo es una curva cuadrática con el control al doble de la amplitud.
function ola(periodo: number, amplitud: number, base: number, fase = 1) {
  let d = `M0 ${base}`;
  for (let x = 0, s = fase; x < 2880; x += periodo / 2, s = -s) {
    d += ` Q${x + periodo / 4} ${base - 2 * amplitud * s} ${x + periodo / 2} ${base}`;
  }
  return `${d} V64 H0 Z`;
}
// Ritmos distintos (3 y 2 crestas por pantalla) para que el cruce de capas no se vea mecánico.
const OLA_FRENTE = ola(480, 9, 34);
const OLA_FONDO = ola(720, 11, 28, -1);
---
<section id="cotizar" class="cierre" aria-labelledby="cta-t" data-cierre>
  <div class="olas" aria-hidden="true" data-olas>
    <svg class="ola fondo" viewBox="0 0 2880 64" preserveAspectRatio="none" data-ola="fondo"><path d={OLA_FONDO}></path></svg>
    <svg class="ola frente" viewBox="0 0 2880 64" preserveAspectRatio="none" data-ola="frente"><path d={OLA_FRENTE}></path></svg>
  </div>
  <div class="wrap interior">
    <div class="texto">
      <h2 id="cta-t" class="titulo-seccion">{h.titulo}</h2>
      <p>{h.lead}</p>
    </div>
    <div class="ctas">
      <a class="boton boton-tinta boton-grande" href={rutas.contacto[locale]} data-magnetico>{h.cotizar}</a>
      <a class="boton boton-borde boton-grande" href={`tel:+${SITE.whatsapp}`}>{SITE.phoneDisplay}</a>
    </div>
    <button class="pausa" type="button" hidden aria-pressed="false" data-olas-pausa data-pausar={s.pause} data-reanudar={s.resume}>{s.pause}</button>
  </div>
</section>

<style>
  .cierre { position: relative; isolation: isolate; background: var(--color-antidote); color: var(--color-ink); }
  /* Las olas sobresalen por encima de la franja, sobre el blanco de la sección anterior. */
  .olas { position: absolute; left: 0; right: 0; bottom: 100%; height: 64px; overflow: hidden; pointer-events: none; transform-origin: bottom; }
  .ola { position: absolute; left: 0; bottom: -1px; width: 200%; height: 100%; }
  .fondo path { fill: var(--color-glow); }
  .fondo { opacity: 0.7; }
  .frente path { fill: var(--color-antidote); }
  @media (max-width: 700px) { .olas { height: 36px; } }

  .interior { position: relative; padding-block: 72px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .texto { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .titulo-seccion { line-height: 1.12; }
  .texto p { margin: 0; font-size: 18px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .boton-grande { min-height: 56px; padding: 0 30px; }
  .cierre :focus-visible { outline-color: var(--color-ink); }

  .pausa { position: absolute; right: 24px; bottom: 10px; display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 0; border-radius: 999px; background: none; color: var(--color-ink); font: 500 13px/1 var(--font-sans); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .pausa[hidden] { display: none; }
  @media (max-width: 600px) { .pausa { right: 16px; } }
  @media (prefers-reduced-motion: reduce) { .pausa { display: none; } }
</style>
