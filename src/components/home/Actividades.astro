---
// Biblioteca de actividades: texto a la izquierda y una pantalla de trivia de ejemplo.
// La trivia es una ilustración (no responde a clics): la real sale de la biblioteca.
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio.actividades;
const tr = h.trivia;
const ELEGIDA = 1;
---
<section id="actividades" class="actividades" aria-labelledby="actividades-t">
  <div class="wrap interior">
    <div class="texto">
      <p class="plataforma">{h.plataforma}</p>
      <h2 id="actividades-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
      <p class="lead">{h.lead}</p>
      <ul>
        {h.puntos.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <a class="boton boton-cian boton-grande" href="#cotizar">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
        {s.inicio.probar}
      </a>
    </div>

    <div class="pantalla-wrap">
      <figure class="pantalla" aria-label={tr.label}>
        <div class="fila"><span>{tr.progreso}</span><span class="tiempo">{tr.tiempo}</span></div>
        <div class="barra" aria-hidden="true"><span></span></div>
        <p class="pregunta">{tr.pregunta}</p>
        <ol class="opciones">
          {tr.opciones.map((o, i) => (
            <li class:list={{ elegida: i === ELEGIDA }}>
              {o}{i === ELEGIDA && <span class="sr"> ({tr.elegida})</span>}
            </li>
          ))}
        </ol>
        <div class="fila pie"><span>{tr.conectados}</span><strong>{tr.posicion}</strong></div>
      </figure>
    </div>
  </div>
</section>

<style>
  .actividades { background: var(--color-ink); color: var(--color-paper); }
  .interior { padding-block: 84px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .texto { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .plataforma { margin: 0; color: var(--color-glow); font-weight: 600; font-size: 15px; }
  .lead { margin: 0; color: var(--color-fg-soft); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  li { display: flex; gap: 12px; align-items: flex-start; }
  ul svg { width: 22px; height: 22px; flex: none; margin-top: 3px; fill: none; stroke: var(--color-antidote); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .boton { align-self: flex-start; }
  .actividades :focus-visible { outline-color: var(--color-antidote); }

  .pantalla-wrap { flex: 1 1 380px; min-width: 0; display: flex; justify-content: center; }
  .pantalla { margin: 0; width: 100%; max-width: 472px; border-radius: 28px; background: var(--color-paper); color: var(--color-ink); padding: 26px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.45); }
  .fila { display: flex; justify-content: space-between; align-items: center; font-size: 14px; font-weight: 600; }
  .tiempo { padding: 4px 10px; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); }
  .barra { height: 8px; border-radius: 999px; background: var(--color-line-soft); overflow: hidden; }
  .barra span { display: block; width: 62%; height: 100%; background: var(--color-antidote); }
  .pregunta { margin: 0; font: 400 23px/1.25 var(--font-display); }
  .opciones { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .opciones li { display: flex; align-items: center; min-height: 50px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--color-line-input); background: var(--color-paper); font-size: 15px; font-weight: 500; line-height: 1.3; }
  .opciones .elegida { border-color: var(--color-ink); background: var(--color-antidote); font-weight: 600; }
  .pie { color: var(--color-slate); font-weight: 400; }
  .pie strong { color: var(--color-ink); font-weight: 600; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
