---
// Biblioteca de actividades: texto a la izquierda y, a la derecha, cómo se ven los resultados al
// terminar una actividad (por equipo). La trivia jugable vive en el hero; aquí el botón sube a
// ella. Los resultados son un ejemplo ilustrativo: los reales salen de la biblioteca.
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const h = s.inicio.actividades;
const r = h.resultados;
---
<section id="actividades" class="actividades" aria-labelledby="actividades-t">
  <div class="wrap interior">
    <div class="texto">
      <p class="plataforma">{h.plataforma}</p>
      <h2 id="actividades-t" class="titulo-seccion">{h.titulo[0]}<span class="resaltado">{h.titulo[1]}</span></h2>
      <p class="lead">{h.lead}</p>
      <ul>
        {h.puntos.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <a class="boton boton-cian boton-grande" href="#trivia" data-magnetico>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
        {s.inicio.probar}
      </a>
    </div>

    <div class="pantalla-wrap">
      <figure class="resultados" aria-labelledby="resultados-t" data-resultados>
        <div class="r-cab"><p class="r-titulo" id="resultados-t">{r.titulo}</p><span class="r-col">{r.columna}</span></div>
        <ol>
          {r.equipos.map(([equipo, pct], i) => (
            <li>
              <span class="r-pos" aria-hidden="true">{i + 1}</span>
              <span class="r-nombre">{equipo}</span>
              <span class="r-barra" aria-hidden="true"><span style={`transform: scaleX(${Number(pct) / 100})`} data-pct={pct}></span></span>
              <strong class="r-pct" data-cifra>{pct}</strong>
            </li>
          ))}
        </ol>
        <p class="r-pie">{r.pie}</p>
      </figure>
    </div>
  </div>
</section>

<style>
  .actividades { background: var(--color-ink); color: var(--color-paper); }
  .interior { padding-block: 84px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .texto { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .plataforma { margin: 0; color: var(--color-glow); font-weight: 600; font-size: 15px; }
  .lead { margin: 0; color: var(--color-fg-soft); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  ul li { display: flex; gap: 12px; align-items: flex-start; }
  ul svg { width: 22px; height: 22px; flex: none; margin-top: 3px; fill: none; stroke: var(--color-antidote); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .boton { align-self: flex-start; }
  .actividades :focus-visible { outline-color: var(--color-antidote); }

  .pantalla-wrap { flex: 1 1 380px; min-width: 0; display: flex; justify-content: center; }
  .resultados { margin: 0; width: 100%; max-width: 472px; border-radius: 28px; background: var(--color-paper); color: var(--color-ink); padding: 26px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.45); }
  .r-cab { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .r-titulo { margin: 0; font: 400 23px/1.25 var(--font-display); }
  .r-col { font-size: 13px; color: var(--color-slate); }
  ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  ol li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; grid-template-areas: 'pos nombre pct' 'pos barra barra'; align-items: center; gap: 4px 10px; }
  .r-pos { grid-area: pos; width: 28px; height: 28px; border-radius: 50%; background: var(--color-mist); display: grid; place-items: center; font-size: 13px; font-weight: 600; }
  ol li:first-child .r-pos { background: var(--color-antidote); }
  .r-nombre { grid-area: nombre; font-size: 15px; font-weight: 500; }
  .r-pct { grid-area: pct; font: 400 22px/1.1 var(--font-accent); color: var(--color-deep); }
  .r-pct::after { content: ' %'; font: 500 13px var(--font-sans); color: var(--color-slate); }
  .r-barra { grid-area: barra; height: 8px; border-radius: 999px; background: var(--color-line-soft); overflow: hidden; }
  .r-barra span { display: block; height: 100%; background: linear-gradient(90deg, var(--color-mid), var(--color-antidote)); transform-origin: left; }
  .r-pie { margin: 0; font-size: 14px; color: var(--color-slate); }
</style>
