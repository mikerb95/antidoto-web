---
// "Retos → soluciones" como pieza tipográfica. Cada fila es una palabra grande: arranca como
// el reto (coral) y, al bajar, una línea de líquido cian la cruza de izquierda a derecha y la
// reemplaza por la solución. El reto queda arriba como etiqueta tachada. Es el antídoto
// actuando sobre el problema, sin diagramas.
// El HTML trae el estado final (solución visible, reto tachado); el script parte del reto.
import Encabezado from './Encabezado.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  num?: string;
}
const s = t(Astro.props.locale);
const pares = s.retos.map((reto, i) => ({ reto, solucion: s.soluciones[i] }));
---
<section class="seccion retos" aria-labelledby="retos-title" data-retos>
  <div class="wrap">
    <Encabezado kicker={s.retosKicker} titulo={s.retosTitle} lead={s.retosLead} id="retos-title" />
    <ol class="filas">
      {pares.map(({ reto, solucion }) => (
        <li class="fila" data-fila>
          <p class="reto-label"><span class="etq">{s.retosLabel.replace(/s$/, '')}</span><span class="tachado" data-tachado>{reto}</span></p>
          <p class="palabra">
            <span class="sr">{reto}: {solucion}</span>
            <span class="capa sol" aria-hidden="true" data-sol>{solucion}</span>
            <span class="capa reto" aria-hidden="true" data-reto>{reto}</span>
            <span class="menisco" aria-hidden="true" data-menisco></span>
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { gsap, pieza } from '../lib/motion/core';

  const raiz = document.querySelector<HTMLElement>('[data-retos]');
  if (raiz) {
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-fila]')];
    pieza(
      'retos',
      () => {
        raiz.classList.add('is-animado');
        filas.forEach((fila) => {
          const sol = fila.querySelector('[data-sol]');
          const reto = fila.querySelector('[data-reto]');
          const menisco = fila.querySelector('[data-menisco]');
          const tachado = fila.querySelector('[data-tachado]');
          // Todo en porcentajes: mezclar % y px en clip-path hace saltar la animación.
          gsap.timeline({
            defaults: { ease: 'none' },
            scrollTrigger: { trigger: fila, start: 'top 82%', end: 'top 38%', scrub: 0.5 },
          })
            .fromTo(sol, { clipPath: 'inset(-10% 100% -20% 0%)' }, { clipPath: 'inset(-10% 0% -20% 0%)' }, 0)
            .fromTo(reto, { clipPath: 'inset(-10% 0% -20% 0%)' }, { clipPath: 'inset(-10% 0% -20% 100%)' }, 0)
            .fromTo(menisco, { left: '0%', opacity: 1 }, { left: '100%' }, 0)
            .to(menisco, { opacity: 0, duration: 0.08 }, 0.92)
            .fromTo(tachado, { '--tachado': 0 }, { '--tachado': 1, duration: 0.5 }, 0.5);
        });
      },
      () => raiz.classList.remove('is-animado'),
    );
  }
</script>

<style>
  .filas { list-style: none; margin: 40px 0 0; padding: 0; border-top: 1px solid var(--color-line); }
  .fila { padding: 22px 0 26px; border-bottom: 1px solid var(--color-line); }
  .reto-label { display: flex; align-items: baseline; gap: 12px; margin: 0 0 6px; font: 600 12px/1 var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-fg-muted); }
  .tachado { position: relative; color: var(--color-reto); letter-spacing: 0.06em; }
  /* Tachado que crece; en el estado final (sin JS) está completo. */
  .tachado::after { content: ''; position: absolute; left: -2px; right: -2px; top: 50%; height: 2px; background: currentColor; transform: scaleX(var(--tachado, 1)); transform-origin: left; }

  .palabra { position: relative; display: inline-grid; margin: 0; font: 400 clamp(46px, 7.4vw, 120px)/1 var(--font-display); letter-spacing: -0.035em; }
  .capa { grid-area: 1 / 1; white-space: nowrap; }
  .sol { background-image: linear-gradient(100deg, var(--color-glow), var(--color-antidote) 40%, var(--color-mid)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .reto { color: var(--color-reto); display: none; }
  .menisco { display: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Con el script: aparece la capa del reto y la línea de líquido que la cruza. */
  .retos:global(.is-animado) .reto { display: block; }
  .retos:global(.is-animado) .menisco { display: block; position: absolute; top: -6%; bottom: -10%; width: 3px; margin-left: -1px; border-radius: 3px; background: var(--color-antidote); box-shadow: 0 0 18px 3px rgb(59 200 243 / 0.65); }
</style>
