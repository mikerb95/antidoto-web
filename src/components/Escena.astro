---
// Escena de un servicio: foto real + su animación firma, que demuestra lo que hace el
// servicio. Se usa dos veces: en la ventana fija de escritorio y dentro de cada paso en móvil.
import { Image } from 'astro:assets';
import type { Servicio } from '../data/servicios';

interface Props {
  servicio: Servicio;
  /** Texto alternativo; vacío cuando la escena es una copia decorativa. */
  alt: string;
  provisionalLabel: string;
}
const { servicio, alt, provisionalLabel } = Astro.props;
const id = servicio.id;
---
<figure class="escena" data-escena={id}>
  <Image class="foto" src={servicio.image} alt={alt} widths={[480, 720, 960]} sizes="(max-width: 899px) 100vw, 540px" loading="lazy" data-foto />
  <svg class="firma" viewBox="0 0 160 100" aria-hidden="true" data-firma={id}>
    {id === 'formaciones' && (
      <g fill="none" stroke="currentColor" stroke-width="1.8">
        <path class="trazo" pathLength="1" d="M22 70 L58 28 L100 46 L138 20 M58 28 L78 80 L100 46 M22 70 L78 80" />
        <g fill="currentColor" stroke="none">
          <circle class="nodo" cx="22" cy="70" r="7" /><circle class="nodo" cx="58" cy="28" r="7" /><circle class="nodo" cx="100" cy="46" r="7" /><circle class="nodo" cx="138" cy="20" r="7" /><circle class="nodo" cx="78" cy="80" r="7" />
        </g>
      </g>
    )}
    {id === 'audiovisual' && (
      <g fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M6 22 V6 H22 M138 6 H154 V22 M154 78 V94 H138 M22 94 H6 V78" />
        <path d="M72 50 h16 M80 42 v16" stroke-width="1.4" />
        <circle class="rec" cx="20" cy="24" r="5" fill="#FF7A59" stroke="none" />
        <text x="30" y="28" class="tc">REC</text>
        <text x="80" y="86" text-anchor="middle" class="tc" data-timecode>00:00:00:00</text>
      </g>
    )}
    {id === 'catering' && (
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path class="vapor" d="M58 56 q-7 -9 0 -18 t0 -18" /><path class="vapor v2" d="M80 56 q-7 -9 0 -18 t0 -18" /><path class="vapor v3" d="M102 56 q-7 -9 0 -18 t0 -18" />
        <path d="M34 68 H126 M42 68 q38 30 76 0" />
      </g>
    )}
    {id === 'diseno' && (
      <g fill="none" stroke="currentColor" stroke-width="2.2">
        <path class="relleno" fill="currentColor" stroke="none" d="M40 84 C40 36 62 16 80 16 C98 16 120 36 120 84 Z" />
        <path class="trazo" pathLength="1" d="M40 84 C40 36 62 16 80 16 C98 16 120 36 120 84 Z" />
        <g fill="#0F181D" stroke="currentColor" stroke-width="1.6"><rect x="35" y="79" width="10" height="10" /><rect x="75" y="11" width="10" height="10" /><rect x="115" y="79" width="10" height="10" /></g>
      </g>
    )}
  </svg>
  {servicio.provisional && <figcaption class="tag">{provisionalLabel}</figcaption>}
</figure>

<style>
  .escena { position: relative; margin: 0; aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; background: var(--color-ink-raised); isolation: isolate; }
  .foto { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Velo inferior para que la firma y la etiqueta lean sobre cualquier foto. */
  .escena::after { content: ''; position: absolute; inset: 0; background: linear-gradient(200deg, rgb(15 24 29 / 0.72) 0%, rgb(15 24 29 / 0) 45%); pointer-events: none; }
  .firma { position: absolute; top: 16px; right: 16px; width: 150px; height: auto; z-index: 1; color: var(--color-antidote); overflow: visible; }
  .tc { font: 500 11px var(--font-mono); fill: var(--color-fg); stroke: none; }
  .relleno { opacity: 0.22; }
  .tag { position: absolute; left: 12px; bottom: 12px; z-index: 1; font: 500 11px/1 var(--font-mono); background: rgb(10 17 21 / 0.82); padding: 7px 9px; border-radius: 6px; color: var(--color-fg); }

  /* Bucles de firma: corren solo mientras la escena está activa (clase que pone el script)
     y se detienen solos a los ~6 s. Sin la clase, la firma queda quieta y completa. */
  .escena:global(.is-activa) .rec { animation: rec 1s steps(1) 6; }
  @keyframes rec { 50% { opacity: 0; } }
  .escena:global(.is-activa) .vapor { animation: vapor 2.4s var(--ease-in-out) 3 backwards; }
  .escena:global(.is-activa) .vapor.v2 { animation-delay: 0.8s; }
  .escena:global(.is-activa) .vapor.v3 { animation-delay: 1.6s; }
  @keyframes vapor { 0% { transform: translateY(8px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateY(-14px); opacity: 0; } }
</style>
