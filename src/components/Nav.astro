---
// Barra de navegación tipo píldora. Sale del grupo root de la view transition
// (view-transition-name propio): es igual en todas las páginas y no debe fundirse.
import Logo from './Logo.astro';
import { t, rutas, otroIdioma, type Locale, type Pagina } from '../i18n/ui';

interface Props {
  locale: Locale;
  actual: Pagina | null;
  /** Ruta equivalente en el otro idioma. */
  alternateHref: string;
}
const { locale, actual, alternateHref } = Astro.props;
const s = t(locale);
const items: Exclude<Pagina, 'inicio'>[] = ['servicios', 'clientes', 'nosotros', 'contacto'];
const otro = otroIdioma(locale);
---
<header class="nav">
  <div class="pill">
    <a href={rutas.inicio[locale]} class="home" aria-label={s.homeLabel}><Logo class="logo" /></a>
    <nav aria-label={s.menuLabel} class="links">
      <ul>
        {items.map((k) => (
          <li><a href={rutas[k][locale]} aria-current={actual === k ? 'page' : undefined}>{s.nav[k]}</a></li>
        ))}
      </ul>
    </nav>
    <div class="acciones">
      <div class="idioma" role="group" aria-label={s.langLabel}>
        <span class="activo" aria-current="true">{locale.toUpperCase()}</span>
        <a href={alternateHref} hreflang={otro} lang={otro} aria-label={s.switchLangLabel}>{otro.toUpperCase()}</a>
      </div>
      <a class="btn btn-primary btn-sm cta" href={rutas.contacto[locale]}>{s.navQuote}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-abrir>
        <span class="sr">{s.menuOpen}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>

  <div class="menu" id="menu-movil" hidden data-menu>
    <div class="menu-top">
      <span class="mono">{s.menuLabel}</span>
      <button class="menu-btn visible" type="button" data-menu-cerrar>
        <span class="sr">{s.menuClose}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <ul>
      <li><a href={rutas.inicio[locale]} aria-current={actual === 'inicio' ? 'page' : undefined}><span class="mono">00</span>{locale === 'es' ? 'Inicio' : 'Home'}</a></li>
      {items.map((k, i) => (
        <li style={`--i:${i + 1}`}><a href={rutas[k][locale]} aria-current={actual === k ? 'page' : undefined}><span class="mono">0{i + 1}</span>{s.nav[k]}</a></li>
      ))}
    </ul>
    <a class="menu-idioma" href={alternateHref} hreflang={otro} lang={otro}>{s.switchLangLabel}</a>
  </div>
</header>

<script>
  // Menú móvil a pantalla completa: aria-expanded, cierre con Esc, foco dentro y scroll
  // del body bloqueado mientras está abierto.
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]');
  const cerrar = document.querySelector<HTMLButtonElement>('[data-menu-cerrar]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (abrir && cerrar && menu) {
    const enfocables = () => [...menu.querySelectorAll<HTMLElement>('a, button')];
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') cerrarMenu();
      if (e.key !== 'Tab') return;
      const f = enfocables();
      const primero = f[0];
      const ultimo = f[f.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    };
    const abrirMenu = () => {
      menu.hidden = false;
      abrir.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      cerrar.focus();
    };
    const cerrarMenu = () => {
      menu.hidden = true;
      abrir.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      abrir.focus();
    };
    abrir.addEventListener('click', abrirMenu);
    cerrar.addEventListener('click', cerrarMenu);
  }
</script>

<style>
  .nav { position: fixed; top: calc(env(safe-area-inset-top, 0px) + 12px); left: 0; right: 0; z-index: 40; padding-inline: 16px; view-transition-name: nav; pointer-events: none; }
  .pill {
    pointer-events: auto; max-width: 1200px; margin-inline: auto; height: 60px; padding: 0 8px 0 20px;
    display: flex; align-items: center; gap: 24px; border-radius: 999px;
    background: rgb(10 17 21 / 0.78); border: 1px solid rgb(128 220 255 / 0.12);
    backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.45);
  }
  .home { display: block; color: var(--color-antidote); }
  .home :global(.logo) { display: block; width: 118px; height: auto; }
  .links { margin-left: auto; }
  .links ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a { display: block; padding: 10px 14px; border-radius: 999px; text-decoration: none; font-size: 14px; color: var(--color-fg-muted); transition: color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
  .links a:hover { color: var(--color-fg); }
  .links a[aria-current='page'] { color: var(--color-fg); background: rgb(59 200 243 / 0.12); }
  .acciones { display: flex; align-items: center; gap: 8px; }
  .idioma { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px; border: 1px solid var(--color-line); font: 500 11px/1 var(--font-mono); letter-spacing: 0.1em; }
  .idioma > * { display: grid; place-items: center; min-width: 36px; height: 34px; border-radius: 999px; }
  .idioma .activo { background: rgb(59 200 243 / 0.16); color: var(--color-antidote); }
  .idioma a { color: var(--color-fg-muted); text-decoration: none; }
  .idioma a:hover { color: var(--color-fg); }
  .menu-btn { display: none; width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--color-line); background: none; color: var(--color-fg); cursor: pointer; place-items: center; }
  .menu-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .menu { position: fixed; inset: 0; z-index: 50; pointer-events: auto; background: rgb(10 17 21 / 0.97); backdrop-filter: blur(20px); padding: calc(env(safe-area-inset-top, 0px) + 22px) 20px 32px; display: flex; flex-direction: column; gap: 24px; }
  .menu[hidden] { display: none; }
  .menu-top { display: flex; justify-content: space-between; align-items: center; }
  .menu .visible { display: grid; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu li { animation: entra var(--t-slow) var(--ease-out) both; animation-delay: calc(var(--i, 0) * 60ms); }
  @keyframes entra { from { transform: translateY(16px); opacity: 0; } }
  .menu ul a { display: flex; align-items: baseline; gap: 16px; padding: 12px 0; font: 400 36px/1.1 var(--font-display); text-decoration: none; border-bottom: 1px solid var(--color-line); }
  .menu ul a[aria-current='page'] { color: var(--color-antidote); }
  .menu-idioma { margin-top: auto; color: var(--color-fg-muted); font-size: 15px; min-height: 44px; display: inline-flex; align-items: center; }

  @media (max-width: 900px) {
    .links, .idioma { display: none; }
    .acciones { margin-left: auto; }
    .menu-btn { display: grid; }
    .pill { padding-left: 16px; }
  }
  @media (max-width: 380px) { .cta { display: none; } }
</style>
