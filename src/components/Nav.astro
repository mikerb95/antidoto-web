---
// Barra de navegación del diseño claro (antidoto-home-diseno): logo, enlaces a las secciones
// de la home, selector de idioma y botón Cotizar. Va en todas las páginas y no es fija.
// Tiene view-transition-name propio: es igual en todas las páginas y no se funde al navegar.
import Logo from './Logo.astro';
import { t, rutas, otroIdioma, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Ruta equivalente en el otro idioma. */
  alternateHref: string;
}
const { locale, alternateHref } = Astro.props;
const s = t(locale);
const home = rutas.inicio[locale];
const otro = otroIdioma(locale);
const enlaces = [
  [`${home}#servicios`, s.nav.servicios],
  [`${home}#actividades`, s.navActividades],
  [`${home}#para-quien`, s.navParaQuien],
  [`${home}#nosotros`, s.nav.nosotros],
];
---
<header class="nav">
  <div class="barra wrap">
    <a href={home} class="home" aria-label={s.homeLabel}><Logo class="logo" /></a>
    <nav aria-label={s.menuLabel} class="links">
      {enlaces.map(([href, label]) => <a href={href}>{label}</a>)}
      <a class="idioma" href={alternateHref} hreflang={otro} lang={otro} aria-label={s.switchLangLabel}>
        <span class="actual">{locale.toUpperCase()}</span><span aria-hidden="true">/</span><span>{otro.toUpperCase()}</span>
      </a>
      <a class="boton boton-cian cotizar" href={rutas.contacto[locale]}>{s.navQuote}</a>
    </nav>
  </div>
</header>

<style>
  .nav { position: relative; z-index: 40; background: var(--color-paper); border-bottom: 1px solid var(--color-line-soft); padding-top: env(safe-area-inset-top, 0px); view-transition-name: nav; }
  .barra { padding-block: 14px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .home { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-antidote); }
  .home :global(.logo) { display: block; height: 34px; width: auto; }

  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; }
  .links a:not(.boton) { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink); text-decoration: none; font-weight: 500; font-size: 16px; }
  .links a:not(.boton):hover { color: var(--color-deep); }
  .idioma { gap: 6px; font-size: 14px !important; font-weight: 600 !important; letter-spacing: 0.06em; color: var(--color-slate) !important; }
  .idioma .actual { color: var(--color-deep); }
  .cotizar { font-size: 16px; padding: 0 22px; }
  .links :focus-visible { outline-color: var(--color-deep); }

  @media (max-width: 600px) {
    .links { gap: 0 18px; }
    .links a:not(.boton) { font-size: 15px; }
  }
</style>
