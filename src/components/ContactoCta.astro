---
// Cierre de página: siguiente paso hacia el cotizador, con los canales directos a mano.
import WhatsappIcon from './WhatsappIcon.astro';
import { t, rutas, type Locale } from '../i18n/ui';
import { SITE, waLink } from '../data/site';

interface Props {
  locale: Locale;
  message?: string;
  num?: string;
}
const { locale, message, num = '04' } = Astro.props;
const s = t(locale);
---
<section class="seccion cta" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="caja panel">
      <div class="texto">
        <p class="kicker mono mono-acento">{s.ctaKicker}</p>
        <h2 id="cta-title">{s.ctaTitle}</h2>
      </div>
      <div class="acciones">
        <a class="btn btn-primary" href={rutas.contacto[locale]} data-magnetico><span class="btn-inner" data-magnetico-texto>{s.ctaCotizador} →</span></a>
        <a class="linea" href={waLink(message ?? s.waDefault)} target="_blank" rel="noopener"><WhatsappIcon /><span><span class="mono">{s.ctaWhatsapp}</span>{SITE.phoneDisplay}</span></a>
        <a class="linea" href={`mailto:${SITE.email}`}><svg class="sobre" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z M4 7l8 6 8-6" /></svg><span><span class="mono">{s.ctaEmail}</span>{SITE.email}</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .caja { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; padding: 40px; overflow: hidden; }
  .caja::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(60% 90% at 100% 100%, rgb(59 200 243 / 0.18), transparent 70%); pointer-events: none; }
  .kicker { margin: 0 0 12px; }
  h2 { margin: 0 0 18px; font-size: clamp(28px, 2.4vw + 10px, 44px); line-height: 1.05; letter-spacing: -0.02em; }
  .estado { display: inline-flex; align-items: center; gap: 10px; margin: 0; }
  .acciones { display: grid; gap: 10px; align-content: center; }
  .acciones .btn { justify-self: start; }
  .linea { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 14px; border-radius: 12px; border: 1px solid var(--color-line); text-decoration: none; color: var(--color-fg); font-size: 14px; transition: border-color var(--t-base) var(--ease-out); min-width: 0; }
  .linea:hover { border-color: rgb(59 200 243 / 0.45); }
  .linea > span { display: grid; min-width: 0; overflow-wrap: anywhere; }
  .linea .mono { font-size: 10px; }
  .linea :global(svg) { width: 20px; height: 20px; flex: none; color: var(--color-antidote); fill: currentColor; }
  .linea .sobre { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  @media (max-width: 860px) { .caja { grid-template-columns: 1fr; padding: 28px 22px; gap: 24px; } }
</style>
