---
// Encabezado de sección: un marcador con forma de frasco (el círculo del logo con su nivel
// de líquido) seguido de la etiqueta, el título y la bajada.
interface Props {
  kicker: string;
  titulo: string;
  lead?: string;
  id?: string;
  /** Se mantiene por compatibilidad; ya no se muestra. */
  num?: string;
  /** h1 en la cabecera de página, h2 en las secciones. */
  nivel?: 1 | 2;
  claro?: boolean;
}
const { kicker, titulo, lead, id, nivel = 2, claro = false } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---
<div class:list={['enc', { claro }]}>
  <p class="kicker">
    <svg class="frasquito" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="10" cy="10" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M3.4 11h13.2a6.6 6.6 0 0 1-13.2 0z" fill="currentColor" />
    </svg>
    <span>{kicker}</span>
  </p>
  <H id={id} class:list={['titulo', { grande: nivel === 1 }]}>{titulo}</H>
  {lead && <p class="bajada">{lead}</p>}
  <slot />
</div>

<style>
  .enc { display: grid; gap: 14px; max-width: 780px; }
  .kicker { display: inline-flex; align-items: center; gap: 10px; margin: 0; font: 600 12px/1 var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-antidote); }
  .frasquito { width: 18px; height: 18px; flex: none; }
  .titulo { margin: 0; font-size: clamp(32px, 2.8vw + 12px, 52px); line-height: 1.03; letter-spacing: -0.02em; }
  .titulo.grande { font-size: clamp(40px, 4.4vw + 12px, 76px); line-height: 0.98; }
  .bajada { margin: 0; color: var(--color-fg-muted); font-size: clamp(16px, 0.6vw + 12px, 18px); max-width: 40em; }
  .claro .kicker { color: var(--color-deep); }
  .claro .bajada { color: var(--color-bone-muted); }
</style>
