---
import Logo from './Logo.astro';
import { t, rutas, rutaPolitica, type Locale } from '../i18n/ui';
import { NOVEDADES, NOVEDADES_VERSION } from '../data/consentimiento';
import { SITE, waLink } from '../data/site';
import { obtenerServicios, servicioPath } from '../data/servicios';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const SERVICIOS = await obtenerServicios();
const year = new Date().getFullYear();
// La suscripción solo aparece si el build trae la API (ver api/README.md).
const api = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
---
<footer class="foot">
  <div class="wrap pie">
    <div class="grid">
      <div class="marca">
        <a href={rutas.inicio[locale]} class="home" aria-label={s.homeLabel}><Logo class="logo" /></a>
        <p>{s.footerLema}</p>
        {api && (
          <form class="novedades" hidden data-novedades data-api={api} data-version={NOVEDADES_VERSION} novalidate aria-labelledby="novedades-t">
            <p class="titulo" id="novedades-t">{s.novedadesTitulo}</p>
            <p class="nov-texto">{s.novedadesTexto}</p>
            <div class="nov-fila">
              <label class="sr" for="novedades-email">{s.novedadesCorreo}</label>
              <input id="novedades-email" type="email" name="email" autocomplete="email" required placeholder={s.novedadesCorreo} />
              <button class="boton boton-cian" type="submit">{s.novedadesBoton}</button>
            </div>
            <label class="trampa" aria-hidden="true">Web<input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
            <p class="nov-legal">{NOVEDADES[locale]} <a href={rutaPolitica[locale]}>{s.footerPolitica}</a></p>
            <p class="nov-estado" role="status" data-estado></p>
          </form>
        )}
      </div>
      <nav aria-labelledby="pie-servicios">
        <p class="titulo" id="pie-servicios">{s.footerServicios}</p>
        <ul>{SERVICIOS.map((sv) => <li><a href={servicioPath(sv, locale)}>{sv[locale].title}</a></li>)}</ul>
      </nav>
      <div>
        <p class="titulo">{s.nav.contacto}</p>
        <ul>
          <li><a href={waLink(s.waDefault)} target="_blank" rel="noopener">WhatsApp {SITE.phoneDisplay}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="base">
      <span>© {year} Antídoto. {s.footerDerechos}</span>
      <a class="politica" href={rutaPolitica[locale]}>{s.footerPolitica}</a>
    </div>
  </div>
</footer>

<script>
  import { ui } from '../i18n/ui';

  // Suscripción a novedades: envía a la API y la persona confirma desde su correo (doble
  // confirmación). Al enviar el formulario acepta el texto de autorización que tiene debajo.
  const form = document.querySelector<HTMLFormElement>('[data-novedades]');
  if (form) {
    const locale = document.documentElement.lang.startsWith('es') ? 'es' : 'en';
    const s = ui[locale];
    const estado = form.querySelector<HTMLElement>('[data-estado]')!;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const inicio = Date.now();
    form.hidden = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
        estado.textContent = s.novedadesError;
        email.focus();
        return;
      }
      const boton = form.querySelector('button')!;
      boton.disabled = true;
      try {
        const r = await fetch(`${form.dataset.api}/v1/suscripciones`, {
          method: 'POST',
          headers: { 'content-type': 'text/plain;charset=UTF-8' },
          body: JSON.stringify({
            email: email.value.trim(),
            consentimiento: form.dataset.version,
            web: (form.elements.namedItem('web') as HTMLInputElement).value,
            locale,
            pagina: location.pathname,
            t: Date.now() - inicio,
          }),
        });
        if (!r.ok) throw new Error(String(r.status));
        estado.textContent = s.novedadesEnviado;
        form.reset();
      } catch {
        estado.textContent = s.novedadesError;
      } finally {
        boton.disabled = false;
      }
    });
  }
</script>

<style>
  .foot { background: var(--color-ink); color: var(--color-fg-soft); font-size: 15px; }
  .pie { padding-block: 56px calc(36px + env(safe-area-inset-bottom, 0px)); display: flex; flex-direction: column; gap: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 32px; }
  .marca { display: flex; flex-direction: column; gap: 14px; }
  .home { align-self: flex-start; display: inline-flex; min-height: 44px; align-items: center; color: var(--color-antidote); }
  .home :global(.logo) { display: block; height: 34px; width: auto; }
  .marca > p { margin: 0; }
  .titulo { margin: 0 0 6px; color: var(--color-paper); font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  ul a { color: var(--color-fg-soft); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  ul a:hover { color: var(--color-antidote); }
  .base { border-top: 1px solid rgb(255 255 255 / 0.16); padding-top: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; font-size: 14px; }
  .politica { color: var(--color-fg-soft); display: inline-flex; align-items: center; min-height: 44px; }
  .politica:hover { color: var(--color-antidote); }

  .novedades { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin-top: 8px; max-width: 30em; }
  .novedades[hidden] { display: none; }
  .novedades .titulo { margin: 0; }
  .nov-texto { margin: 0; font-size: 14px; }
  .nov-fila { display: flex; gap: 8px; min-width: 0; }
  .nov-fila input { flex: 1; min-width: 0; min-height: 48px; padding: 0 14px; border-radius: 10px; border: 1px solid rgb(255 255 255 / 0.24); background: rgb(255 255 255 / 0.06); color: var(--color-paper); font: 400 15px var(--font-sans); color-scheme: dark; }
  .nov-fila input::placeholder { color: var(--color-fg-muted); }
  .nov-legal { margin: 0; font-size: 12px; line-height: 1.5; }
  .nov-legal a { color: var(--color-glow); }
  .nov-estado { margin: 0; font-size: 13.5px; color: var(--color-glow); }
  .nov-estado:empty { display: none; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .foot :focus-visible { outline-color: var(--color-antidote); }
</style>
