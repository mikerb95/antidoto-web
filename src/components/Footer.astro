---
import Logo from './Logo.astro';
import { t, rutas, type Locale } from '../i18n/ui';
import { SITE, waLink } from '../data/site';
import { SERVICIOS, servicioPath } from '../data/servicios';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const year = new Date().getFullYear();
const sitio = [
  [rutas.inicio[locale], locale === 'es' ? 'Inicio' : 'Home'],
  [rutas.servicios[locale], s.nav.servicios],
  [rutas.clientes[locale], s.nav.clientes],
  [rutas.nosotros[locale], s.nav.nosotros],
  [rutas.contacto[locale], s.nav.contacto],
];
---
<footer class="foot">
  <div class="wrap grid">
    <div class="marca">
      <Logo class="logo" />
      <p>{s.footerTagline}</p>
    </div>
    <nav aria-label={s.footerSitio}>
      <p class="mono">{s.footerSitio}</p>
      <ul>{sitio.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
    <nav aria-label={s.footerServicios}>
      <p class="mono">{s.footerServicios}</p>
      <ul>{SERVICIOS.map((sv) => <li><a href={servicioPath(sv, locale)}>{sv[locale].title}</a></li>)}</ul>
    </nav>
    <div>
      <p class="mono">{s.footerContacto}</p>
      <ul>
        <li><a href={waLink(s.waDefault)} target="_blank" rel="noopener">WhatsApp {SITE.phoneDisplay}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <p class="mono redes-t">{s.footerRedes}</p>
      <ul class="redes">
        <li><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
    <p class="copy mono">© {year} Antídoto · {SITE.phoneDisplay}</p>
  </div>
</footer>

<style>
  .foot { position: relative; padding-block: 56px calc(40px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--color-line); background: rgb(10 17 21 / 0.72); font-size: 14px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); gap: 32px; }
  .marca :global(.logo) { width: 132px; height: auto; color: var(--color-antidote); display: block; margin-bottom: 14px; }
  .marca p { margin: 0 0 12px; color: var(--color-fg-muted); max-width: 26em; }
  .estado { display: inline-flex; align-items: center; gap: 10px; color: var(--color-fg); }
  .mono { margin: 0 0 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  a { color: var(--color-fg); text-decoration: none; display: inline-flex; align-items: center; min-height: 36px; }
  a:hover { color: var(--color-antidote); }
  .redes-t { margin-top: 18px; }
  .redes { display: flex; gap: 16px; }
  .copy { grid-column: 1 / -1; padding-top: 20px; border-top: 1px solid var(--color-line); margin: 8px 0 0; }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .marca { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
