---
// Cuadrícula de marcas clientes sobre fondo claro. Sin filtro: todas las marcas a la vista.
// En la home muestra una parte y enlaza a /clientes/; en esa página va completa.
import { Image } from 'astro:assets';
import Encabezado from './Encabezado.astro';
import { CLIENTES } from '../data/clientes';
import { t, rutas, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  num: string;
  /** Cuántas marcas mostrar; sin valor, todas. */
  limite?: number;
  /** Nivel del título (1 cuando la sección abre la página /clientes/). */
  nivel?: 1 | 2;
}
const { locale, num, limite, nivel = 2 } = Astro.props;
const s = t(locale);
const lista = limite ? CLIENTES.slice(0, limite) : CLIENTES;
---
<section class="clientes" aria-labelledby="clientes-title" data-hud="muestra">
  <div class="wrap">
    <div class="head">
      <Encabezado num={num} kicker={s.clientsKicker} titulo={s.clientsTitle} lead={s.clientsLead} id="clientes-title" nivel={nivel} claro />
      <p class="total mono"><strong>{CLIENTES.length}</strong> {s.marcas(CLIENTES.length).replace(/^\d+\s/, '')}</p>
    </div>
    <ul class="grid">
      {lista.map((c, i) => (
        <li>
          <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <Image src={c.logo} alt={c.nombre} height={68} loading="lazy" />
        </li>
      ))}
    </ul>
    {limite && <a class="todos" href={rutas.clientes[locale]}>{s.clientsAll} →</a>}
  </div>
</section>

<style>
  .clientes { background: var(--color-bone); color: var(--color-ink); padding-block: 64px; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .total { margin: 0; color: var(--color-bone-muted); }
  .total strong { display: block; font: 400 56px/1 var(--font-accent); letter-spacing: 0; color: var(--color-deep); text-transform: none; }
  .grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; list-style: none; margin: 0; padding: 0; background: var(--color-bone-line); border: 1px solid var(--color-bone-line); border-radius: 16px; overflow: hidden; }
  li { position: relative; background: var(--color-bone); display: grid; place-items: center; padding: 26px 14px; min-height: 104px; transition: background var(--t-base) var(--ease-out); }
  li:hover { background: #fff; }
  .n { position: absolute; top: 8px; left: 10px; font-size: 9.5px; color: var(--color-bone-muted); opacity: 0.7; }
  /* Los logos llegan en blanco; brightness(0) los pasa a tinta sobre el fondo claro. */
  img { max-height: 36px; max-width: 100%; width: auto; height: auto; filter: brightness(0); opacity: 0.75; transition: opacity var(--t-base) var(--ease-out); }
  li:hover img { opacity: 1; }
  .todos { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; font-weight: 600; color: var(--color-deep); text-decoration: none; }
  .todos:hover { text-decoration: underline; }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { li { padding: 18px 8px; min-height: 80px; } img { max-height: 26px; } }
</style>
