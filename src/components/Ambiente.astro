---
// Fondo del sitio: brillos de color fijos detrás del contenido, más el grano.
// La posición y la paleta salen de una semilla de la ruta (sin prefijo de idioma), así
// /servicios y /en/services comparten fondo y cada página se siente distinta al navegar.
// Paletas solo con la marca: cian, azul profundo, brillo y un toque de coral.
// Sin view-transition-name a propósito: se funde junto con la página (grupo root).
interface Props {
  semilla: string;
}
const { semilla } = Astro.props;
let hash = 0;
for (const ch of semilla) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;

const posiciones = [
  ['55% 50% at 8% -6%', '50% 46% at 98% 10%', '48% 44% at 46% 104%'],
  ['52% 48% at 94% -8%', '48% 44% at 0% 30%', '50% 46% at 60% 102%'],
  ['50% 46% at 50% -10%', '54% 50% at 100% 64%', '46% 42% at 0% 96%'],
  ['48% 44% at 4% 26%', '52% 48% at 96% 90%', '50% 46% at 40% -8%'],
];
const paletas = [
  ['rgba(59, 200, 243, .26)', 'rgba(12, 92, 125, .42)', 'rgba(128, 220, 255, .12)'],
  ['rgba(12, 92, 125, .45)', 'rgba(59, 200, 243, .2)', 'rgba(255, 122, 89, .1)'],
  ['rgba(28, 153, 202, .3)', 'rgba(128, 220, 255, .14)', 'rgba(12, 92, 125, .4)'],
  ['rgba(59, 200, 243, .22)', 'rgba(255, 122, 89, .09)', 'rgba(12, 92, 125, .42)'],
];
const pos = posiciones[hash % posiciones.length];
const pal = paletas[Math.floor(hash / posiciones.length) % paletas.length];
const vars = pos.map((p, i) => `--g${i}:radial-gradient(${p}, ${pal[i]}, transparent 68%)`).join(';');
---
<div class="ambiente" aria-hidden="true" style={vars}>
  <span class="brillo b0"></span>
  <span class="brillo b1"></span>
  <span class="brillo b2"></span>
</div>
<div class="grano" aria-hidden="true"></div>

<script>
  import { reducido } from '../lib/motion/core';

  // Deriva lenta con el scroll: varias ondas de frecuencias distintas por brillo para que
  // el movimiento no se sienta mecánico. Sin librería de ruido.
  const brillos = [...document.querySelectorAll<HTMLElement>('.ambiente .brillo')];
  if (brillos.length && !reducido()) {
    const cfg = [
      { ax: 26, ay: 18, f1: 0.0021, f2: 0.0007, g1: 0.0016, g2: 0.0011, fase: 0 },
      { ax: 22, ay: 24, f1: 0.0013, f2: 0.0009, g1: 0.0023, g2: 0.0006, fase: 2.1 },
      { ax: 20, ay: 16, f1: 0.0018, f2: 0.0012, g1: 0.0009, g2: 0.0021, fase: 4.4 },
    ];
    let pendiente = false;
    const mover = () => {
      pendiente = false;
      const y = window.scrollY;
      brillos.forEach((b, i) => {
        const c = cfg[i];
        const dx = c.ax * (Math.sin(y * c.f1 + c.fase) * 0.6 + Math.sin(y * c.f2 + c.fase * 1.7) * 0.4);
        const dy = c.ay * (Math.sin(y * c.g1 + c.fase) * 0.6 + Math.cos(y * c.g2 + c.fase * 1.3) * 0.4);
        b.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
      });
    };
    mover();
    addEventListener('scroll', () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(mover);
      }
    }, { passive: true });
  }
</script>

<style>
  .ambiente { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: var(--color-ink); }
  .brillo { position: absolute; inset: -40px; filter: blur(30px); will-change: transform; transition: transform 1.6s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .b0 { background: var(--g0); }
  .b1 { background: var(--g1); }
  .b2 { background: var(--g2); }
  @media (prefers-reduced-motion: reduce) { .brillo { transition: none; } }
</style>
