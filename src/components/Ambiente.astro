---
// Fondo del sitio: la tinta de la marca con dos brillos (cian arriba, azul profundo abajo) y,
// como marca de agua, el infinito y el frasco del wordmark a gran escala. Estático: el
// movimiento del sitio vive en las piezas, no en el fondo.
import { WORDMARK } from '../data/logo';

interface Props {
  /** Lado donde se ancla la marca de agua; alterna entre páginas para dar variedad. */
  lado?: 'derecha' | 'izquierda';
}
const { lado = 'derecha' } = Astro.props;
---
<div class:list={['ambiente', lado]} aria-hidden="true">
  <svg class="infinito" viewBox="1809 780 1402 540" preserveAspectRatio="xMidYMid meet">
    <g fill="currentColor" set:html={WORDMARK} />
  </svg>
</div>

<style>
  .ambiente {
    position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
    background:
      radial-gradient(70% 55% at 85% -10%, rgb(59 200 243 / 0.2), transparent 70%),
      radial-gradient(60% 50% at 0% 110%, rgb(12 92 125 / 0.45), transparent 70%),
      var(--color-ink);
  }
  .infinito { position: absolute; top: 12%; right: -18%; width: min(1500px, 120vw); height: auto; color: var(--color-antidote); opacity: 0.035; }
  .izquierda .infinito { right: auto; left: -30%; top: 30%; }
</style>
