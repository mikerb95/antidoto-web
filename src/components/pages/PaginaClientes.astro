---
// Clientes: todas las marcas y su reparto por sector. Las marcas se muestran mientras el
// cliente confirma la autorización de cada una (ver src/data/clientes.ts).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../CabeceraPagina.astro';
import BloqueCta from '../BloqueCta.astro';
import { SECTORES } from '../../data/clientes';
import { obtenerClientes } from '../../data/contenido';
import { t, rutas, type Locale } from '../../i18n/ui';
import { tp } from '../../i18n/paginas';
import { grafo, migasSchema } from '../../data/schema';

interface Props {
  locale: Locale;
}
const CLIENTES = await obtenerClientes();
const { locale } = Astro.props;
const s = t(locale);
const p = tp(locale);
const [title, description] = s.seo.clientes;
const sectores = SECTORES.map((sec) => ({ sec, nombre: s.sectors[sec], marcas: CLIENTES.filter((c) => c.sector === sec).map((c) => c.nombre) }));
const migas: Array<[string, string]> = [
  [p.inicio, rutas.inicio[locale]],
  [s.nav.clientes, rutas.clientes[locale]],
];
---
<Base locale={locale} pagina="clientes" title={title} description={description} alternates={rutas.clientes} jsonLd={grafo(migasSchema(migas))} scroll="suave">
  <CabeceraPagina locale={locale} migas={migas} titulo={s.clientsTitle} lead={s.clientsLead}>
    <p class="total" slot="pie"><strong>{CLIENTES.length}</strong> {s.marcas(CLIENTES.length).replace(/^\d+\s/, '')}</p>
  </CabeceraPagina>

  <section class="bloque" aria-label={s.nav.clientes}>
    <div class="wrap">
      <ul class="logos" data-entra>
        {CLIENTES.map((c) => <li><Image src={c.logo} alt={c.nombre} height={68} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <section class="bloque bloque-mist" aria-labelledby="sectores-title">
    <div class="wrap">
      <div class="cab-izq">
        <h2 id="sectores-title">{s.sectorsTitle}</h2>
        <p>{s.sectorsLead}</p>
      </div>
      <ul class="sectores" data-entra>
        {sectores.map(({ sec, nombre, marcas }) => (
          <li class:list={{ destacado: sec === 'sst' || sec === 'ingenieria' }}>
            <p class="cifra">{marcas.length}</p>
            <h3>{nombre}</h3>
            <p class="lista">{marcas.join(' · ')}</p>
            <span class="barra" style={`--p:${(marcas.length / CLIENTES.length) * 100}%`} aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BloqueCta locale={locale} />
</Base>

<style>
  .total { margin: 8px 0 0; display: flex; align-items: baseline; gap: 10px; color: var(--color-slate); font-weight: 500; }
  .total strong { font: 400 56px/1 var(--font-accent); color: var(--color-deep); }
  .logos { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; list-style: none; margin: 0; padding: 0; background: var(--color-line-soft); border: 1px solid var(--color-line-soft); border-radius: 20px; overflow: hidden; }
  .logos li { background: var(--color-paper); display: grid; place-items: center; padding: 26px 14px; min-height: 108px; transition: background var(--t-base) var(--ease-out); }
  .logos li:hover { background: var(--color-mist); }
  /* Los logos llegan en blanco; brightness(0) los pasa a tinta sobre el fondo claro. */
  .logos img { max-height: 36px; max-width: 100%; width: auto; height: auto; filter: brightness(0); opacity: 0.75; transition: opacity var(--t-base) var(--ease-out); }
  .logos li:hover img { opacity: 1; }
  .sectores { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .sectores li { padding: 22px; display: flex; flex-direction: column; gap: 8px; border-radius: 20px; background: var(--color-paper); border: 1px solid var(--color-line-soft); }
  .destacado { box-shadow: 0 10px 30px rgb(12 92 125 / 0.1); }
  .destacado h3::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--color-antidote); vertical-align: middle; }
  .cifra { margin: 0; font: 400 52px/1 var(--font-accent); color: var(--color-deep); }
  h3 { margin: 0; font-size: 20px; line-height: 1.2; }
  .lista { margin: 0; font-size: 14px; color: var(--color-slate); }
  .barra { margin-top: auto; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--color-antidote) var(--p), var(--color-line-soft) var(--p)); }
  @media (max-width: 1020px) { .sectores { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .logos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .sectores { grid-template-columns: 1fr; } .logos li { padding: 18px 8px; min-height: 80px; } .logos img { max-height: 26px; } }
</style>
