---
import Base from '../../layouts/Base.astro';
import Encabezado from '../Encabezado.astro';
import Escena from '../Escena.astro';
import ContactoCta from '../ContactoCta.astro';
import WhatsappIcon from '../WhatsappIcon.astro';
import { SERVICIOS, servicioPath, type Servicio } from '../../data/servicios';
import { t, rutas, type Locale } from '../../i18n/ui';
import { waLink } from '../../data/site';

interface Props {
  locale: Locale;
  servicio: Servicio;
}
const { locale, servicio } = Astro.props;
const s = t(locale);
const txt = servicio[locale];
const msg = s.waService(txt.title);
const n = SERVICIOS.indexOf(servicio) + 1;
const otros = SERVICIOS.filter((x) => x.id !== servicio.id);
const hud: Array<[string, string]> = [
  ['base', s.hud.base],
  ['mezcla', s.hud.mezcla],
  ['muestra', s.hud.muestra],
  ['dosis', s.hud.dosis],
];
---
<Base
  locale={locale}
  pagina="servicios"
  title={`${txt.title} | Antídoto`}
  description={txt.lead}
  alternates={{ es: servicioPath(servicio, 'es'), en: servicioPath(servicio, 'en') }}
  waMessage={msg}
  scroll="suave"
  hud={hud}
>
  <section class="seccion intro" data-hud="base" aria-labelledby="servicio-title">
    <div class="wrap grid">
      <div class="copy">
        <p class="migas mono"><a href={rutas.servicios[locale]}>{s.nav.servicios}</a> / <span class="mono-acento">{s.visorFicha} 0{n}</span></p>
        <h1 id="servicio-title" data-titular style={`view-transition-name: servicio-${servicio.id}-title`}>{txt.title}</h1>
        <p class="lead">{txt.lead}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={waLink(msg)} target="_blank" rel="noopener" data-magnetico><span class="btn-inner" data-magnetico-texto><WhatsappIcon />{s.heroCta}</span></a>
          <a class="btn btn-ghost" href={rutas.contacto[locale]}>{s.ctaCotizador} →</a>
        </div>
      </div>
      <div class="visual">
        <Escena servicio={servicio} alt={txt.alt} provisionalLabel={s.provisional} />
      </div>
    </div>
  </section>

  <section class="seccion ficha-sec" data-hud="mezcla" aria-labelledby="ficha-title">
    <div class="wrap bento">
      <div class="ficha panel">
        <p class="mono" id="ficha-title">{s.fichaServicio} · 0{n}</p>
        <dl>
          <div><dt class="mono">{s.servicioCols[0]}</dt><dd>{txt.title}</dd></div>
          <div><dt class="mono">{s.publico}</dt><dd>{s.publicoTexto}</dd></div>
          {txt.facts.map((f, i) => <div><dt class="mono">{s.servicioCols[2]} 0{i + 1}</dt><dd>{f}</dd></div>)}
        </dl>
      </div>
      <div class="incluye">
        <Encabezado num="02" kicker={s.serviceFor} titulo={txt.title} />
        <ol>
          {txt.includes.map((item, i) => (
            <li class="panel"><span class="mono mono-acento">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="seccion" data-hud="muestra" aria-labelledby="otros-title">
    <div class="wrap">
      <Encabezado num="03" kicker={s.otherServices} titulo={s.servicesTitle} id="otros-title" />
      <ul class="otros">
        {otros.map((o) => {
          const k = SERVICIOS.indexOf(o) + 1;
          return (
            <li>
              <a class="panel" href={servicioPath(o, locale)}>
                <span class="mono mono-acento">0{k}</span>
                <span class="o-t" style={`view-transition-name: servicio-${o.id}-title`}>{o[locale].title}</span>
                <span class="o-d">{o[locale].lead}</span>
                <span class="flecha" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <ContactoCta locale={locale} message={msg} num="04" />
</Base>

<script>
  import { pieza } from '../../lib/motion/core';
  import { activar } from '../../lib/motion/escenas';

  // La escena del servicio se anima una vez al cargar: la firma demuestra el servicio.
  const escena = document.querySelector<HTMLElement>('.visual [data-escena]');
  if (escena) pieza('escena', () => void activar(escena));
</script>

<style>
  .intro { padding-top: 40px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 48px; align-items: center; }
  .migas { margin: 0 0 18px; }
  .migas a { color: var(--color-fg-muted); text-decoration: none; }
  .migas a:hover { color: var(--color-fg); }
  h1 { font-size: clamp(40px, 4vw + 12px, 72px); line-height: 1; letter-spacing: -0.025em; margin: 0 0 20px; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 26px; }
  .visual :global(.escena) { aspect-ratio: 4 / 3.2; }

  .ficha-sec { padding-top: 24px; }
  .bento { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 20px; align-items: start; }
  .ficha { padding: 24px; position: sticky; top: 100px; }
  .ficha > .mono { margin: 0 0 12px; color: var(--color-antidote); }
  dl { margin: 0; display: grid; }
  dl div { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--color-line); }
  dt { margin: 0; }
  dd { margin: 0; font-size: 15px; }
  .incluye ol { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .incluye li { display: flex; flex-direction: column; gap: 18px; padding: 18px; min-height: 120px; justify-content: space-between; font: 400 20px/1.2 var(--font-display); }

  .otros { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .otros a { display: grid; gap: 10px; padding: 20px; height: 100%; color: var(--color-fg); }
  .o-t { font: 400 24px/1.1 var(--font-display); }
  .o-d { font-size: 14px; color: var(--color-fg-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .flecha { color: var(--color-antidote); }

  @media (max-width: 900px) {
    .grid, .bento { grid-template-columns: 1fr; }
    .visual { order: -1; }
    .ficha { position: static; }
    .otros { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) { .incluye ol { grid-template-columns: 1fr; } }
</style>
