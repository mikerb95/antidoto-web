---
// Página de una línea de negocio: qué es, sus ofertas (cada una con su página), para qué áreas,
// casos, preguntas frecuentes y las otras líneas. El cuerpo del Markdown del servicio, si lo
// hay, va como texto largo; si no, una caja .pendiente lo pide al cliente.
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../CabeceraPagina.astro';
import TarjetaIndice from '../TarjetaIndice.astro';
import ListaFaq from '../ListaFaq.astro';
import BloqueCta from '../BloqueCta.astro';
import WhatsappIcon from '../WhatsappIcon.astro';
import { obtenerServicios, servicioPath, type Servicio } from '../../data/servicios';
import { obtenerOfertas, obtenerCasos, ofertaPath, casoPath } from '../../data/contenido';
import { SOLUCIONES, solucionPath } from '../../data/soluciones';
import { preguntas, TEMAS_FAQ, type TemaFaq } from '../../data/faq';
import { t, rutas, type Locale } from '../../i18n/ui';
import { tp } from '../../i18n/paginas';
import { waLink } from '../../data/site';
import { grafo, migasSchema, servicioSchema, faqSchema } from '../../data/schema';

interface Props {
  locale: Locale;
  servicio: Servicio;
}
const { locale, servicio } = Astro.props;
const s = t(locale);
const p = tp(locale);
const txt = servicio[locale];
const msg = s.waService(txt.title);
const servicios = await obtenerServicios();
const otras = servicios.filter((x) => x.id !== servicio.id);
const ofertas = await obtenerOfertas(servicio.id);
const claves = ofertas.map((o) => o.id);
const soluciones = SOLUCIONES.filter((sol) => sol.ofertas.some((o) => claves.includes(o)));
const casos = (await obtenerCasos()).filter((c) => c.es.linea === servicio.id);
const tema = (TEMAS_FAQ as readonly string[]).includes(servicio.id) ? (servicio.id as TemaFaq) : undefined;
const faq = tema ? preguntas(locale, { tema }) : [];

const entrada = txt.entrada ? await getEntry('servicios', txt.entrada) : undefined;
const { Content } = entrada?.body?.trim() ? await render(entrada) : { Content: undefined };

const migas: Array<[string, string]> = [
  [p.inicio, rutas.inicio[locale]],
  [s.nav.servicios, rutas.servicios[locale]],
  [txt.title, servicioPath(servicio, locale)],
];
const foto = await getImage({ src: servicio.image, width: 1200, format: 'jpeg' });
const jsonLd = grafo(servicioSchema(servicio, locale, foto.src), migasSchema(migas), ...(faq.length ? [faqSchema(faq)] : []));
const perfiles = s.inicio.paraQuien.perfiles;
---
<Base
  locale={locale}
  pagina="servicios"
  title={`${txt.title} | Antídoto`}
  description={txt.lead}
  alternates={{ es: servicioPath(servicio, 'es'), en: servicioPath(servicio, 'en') }}
  waMessage={msg}
  jsonLd={jsonLd}
  scroll="suave"
>
  <CabeceraPagina locale={locale} migas={migas} titulo={txt.title} lead={txt.lead} imagen={servicio.image} alt={txt.alt} vt={`servicio-${servicio.id}-title`}>
    <a class="boton boton-cian boton-grande" href={`${rutas.contacto[locale]}?servicio=${servicio.id}`} data-magnetico>{p.cta.cotizador}</a>
    <a class="boton boton-borde boton-grande" href={waLink(msg)} target="_blank" rel="noopener"><WhatsappIcon />WhatsApp</a>
    <ul class="hechos" slot="pie">{txt.facts.map((f) => <li>{f}</li>)}</ul>
  </CabeceraPagina>

  {txt.herramientas && (
    <section class="bloque" aria-labelledby="herramientas-t">
      <div class="wrap">
        <div class="cab-izq">
          <h2 id="herramientas-t">{s.herramientasTitulo[0]}<span class="resaltado">{s.herramientasTitulo[1]}</span></h2>
          <p>{s.herramientasLead}</p>
        </div>
        <ul class="herramientas" data-entra>
          {txt.herramientas.map((h) => (
            <li><span class="h-n">{h.nombre}</span><span class="h-t">{h.texto}</span></li>
          ))}
        </ul>
        {txt.aliado && (
          <div class="aliado">
            <p>{txt.aliado.texto}</p>
            <a class="boton boton-borde" href={txt.aliado.url} target="_blank" rel="noopener">{s.aliadoEnlace(txt.aliado.nombre)}</a>
          </div>
        )}
      </div>
    </section>
  )}

  {ofertas.length > 0 && (
    <section class="bloque" aria-labelledby="ofertas-t">
      <div class="wrap">
        <div class="cab-izq">
          <h2 id="ofertas-t">{p.linea.ofertas[0]}<span class="resaltado">{p.linea.ofertas[1]}</span></h2>
          <p>{p.linea.ofertasLead}</p>
        </div>
        <ul class="rejilla-tarjetas" data-entra>
          {ofertas.map((o, i) => (
            <li>
              <TarjetaIndice href={ofertaPath(servicio, o, locale)} titulo={o[locale].title} texto={o[locale].lead} etiqueta={`0${i + 1}`} cta={p.linea.verOferta} vt={`oferta-${o.id}-title`} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bloque bloque-mist detalle" aria-label={txt.title}>
    <div class="wrap">
      {Content ? <div class="prosa"><Content /></div> : <p class="pendiente">{p.linea.detallePendiente}</p>}
    </div>
  </section>

  {soluciones.length > 0 && (
    <section class="bloque" aria-labelledby="para-t">
      <div class="wrap">
        <div class="cab-izq">
          <h2 id="para-t">{p.linea.paraQuien[0]}<span class="resaltado">{p.linea.paraQuien[1]}</span></h2>
          <p>{p.linea.paraQuienLead}</p>
        </div>
        <ul class="rejilla-tarjetas" data-entra>
          {soluciones.map((sol) => (
            <li><TarjetaIndice href={solucionPath(sol, locale)} titulo={perfiles[sol.perfil][0]} texto={perfiles[sol.perfil][1]} cta={s.inicio.paraQuien.verSoluciones} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bloque" aria-labelledby="casos-t">
    <div class="wrap">
      <div class="cab-izq">
        <h2 id="casos-t">{p.linea.casos[0]}<span class="resaltado">{p.linea.casos[1]}</span></h2>
      </div>
      {casos.length > 0 ? (
        <ul class="rejilla-tarjetas" data-entra>
          {casos.map((c) => (
            <li><TarjetaIndice href={casoPath(c, locale)} titulo={c[locale].title} texto={c[locale].lead} imagen={c.image} alt={c[locale].alt} cta={p.leerMas} /></li>
          ))}
        </ul>
      ) : (
        <p class="pendiente">{p.linea.casoPendiente}</p>
      )}
    </div>
  </section>

  {faq.length > 0 && (
    <section class="bloque bloque-mist" aria-labelledby="faq-t">
      <div class="wrap dos">
        <div class="cab-izq">
          <h2 id="faq-t">{p.linea.faq[0]}<span class="resaltado">{p.linea.faq[1]}</span></h2>
          <a class="mas" href={rutas.faq[locale]}>{p.faq.todas}</a>
        </div>
        <ListaFaq items={faq} />
      </div>
    </section>
  )}

  <section class="bloque" aria-labelledby="otras-t">
    <div class="wrap">
      <div class="cab-izq">
        <h2 id="otras-t">{p.linea.otras[0]}<span class="resaltado">{p.linea.otras[1]}</span></h2>
      </div>
      <ul class="rejilla-tarjetas" data-entra>
        {otras.map((o) => (
          <li><TarjetaIndice href={servicioPath(o, locale)} titulo={o[locale].title} texto={o[locale].lead} imagen={o.image} alt={o[locale].alt} cta={p.servicios.verLinea} vt={`servicio-${o.id}-title`} /></li>
        ))}
      </ul>
    </div>
  </section>

  <BloqueCta locale={locale} servicio={servicio.id} mensaje={msg} />
</Base>

<style>
  .hechos { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hechos li { padding: 6px 12px; border-radius: 999px; background: var(--color-paper); border: 1px solid var(--color-line-soft); font-size: 14px; font-weight: 500; }
  .detalle .pendiente { padding: 32px; }
  .herramientas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 20px; }
  .herramientas li { display: grid; align-content: start; gap: 10px; padding: 24px; border-radius: 22px; background: var(--color-paper); border: 1px solid var(--color-line-soft); box-shadow: 0 10px 30px rgb(15 24 29 / 0.06); }
  .h-n { display: flex; align-items: center; gap: 10px; font: 400 26px/1.1 var(--font-display); }
  .h-n::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--color-antidote); flex: none; }
  .h-t { color: var(--color-slate); font-size: 15px; }
  .aliado { margin-top: 20px; padding: 22px 26px; border-radius: 22px; background: var(--color-ink); color: var(--color-paper); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; }
  .aliado p { margin: 0; max-width: 60ch; }
  .aliado .boton { color: var(--color-paper); border-color: currentColor; }
  .dos { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px; align-items: start; }
  .mas { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; color: var(--color-deep); font-weight: 600; }
  @media (max-width: 900px) { .dos { grid-template-columns: 1fr; gap: 0; } }
</style>
