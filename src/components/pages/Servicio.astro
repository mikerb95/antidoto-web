---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactoCta from '../ContactoCta.astro';
import WhatsappIcon from '../WhatsappIcon.astro';
import { SERVICIOS, servicioPath, type Servicio } from '../../data/servicios';
import { t, type Locale } from '../../i18n/ui';
import { waLink } from '../../data/site';

interface Props {
  locale: Locale;
  servicio: Servicio;
}
const { locale, servicio } = Astro.props;
const s = t(locale);
const txt = servicio[locale];
const msg = s.waService(txt.title);
const otros = SERVICIOS.filter((x) => x.id !== servicio.id);
---
<Base
  locale={locale}
  title={`${txt.title} | Antídoto`}
  description={txt.lead}
  alternates={{ es: servicioPath(servicio, 'es'), en: servicioPath(servicio, 'en') }}
  waMessage={msg}
  scroll="suave"
>
  <section class="intro" data-hero>
    <div class="wrap grid">
      <div>
        <p class="eyebrow">{s.navServices}</p>
        <h1 transition:name={`servicio-${servicio.id}-title`} data-titular>{txt.title}</h1>
        <p class="lead">{txt.lead}</p>
        <ul class="facts">{txt.facts.map((f) => <li>{f}</li>)}</ul>
        <a class="btn btn-primary" href={waLink(msg)} target="_blank" rel="noopener" data-magnetico><span class="btn-inner" data-magnetico-texto><WhatsappIcon />{s.heroCta}</span></a>
      </div>
      <div class="photo" transition:name={`servicio-${servicio.id}-photo`}>
        <Image src={servicio.image} alt={txt.alt} widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 520px" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="includes" aria-labelledby="incluye">
    <div class="wrap">
      <h2 id="incluye">{s.serviceFor}</h2>
      <ul>{txt.includes.map((i) => <li><i aria-hidden="true"></i>{i}</li>)}</ul>
    </div>
  </section>

  <nav class="otros" aria-labelledby="otros">
    <div class="wrap">
      <h2 id="otros" class="eyebrow">{s.otherServices}</h2>
      <ul>{otros.map((o) => <li><a href={servicioPath(o, locale)}>{o[locale].title} →</a></li>)}</ul>
    </div>
  </nav>

  <ContactoCta locale={locale} message={msg} />
</Base>

<style>
  .intro { padding-block: 56px 72px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  h1 { font-size: clamp(38px, 3.6vw + 10px, 64px); line-height: 1.03; margin-block: 14px 20px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 24px 0 28px; padding: 0; }
  .facts li { font-size: 14px; padding: 6px 12px; border-radius: 999px; background: var(--color-ink-raised); }
  .photo { aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; background: var(--color-ink-raised); }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .includes { padding-block: 64px; border-top: 1px solid var(--color-line); }
  .includes h2 { font-size: clamp(26px, 1.6vw + 12px, 36px); margin: 0 0 24px; }
  .includes ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; list-style: none; margin: 0; padding: 0; }
  .includes li { display: flex; gap: 12px; align-items: center; padding: 18px 20px; border-radius: 12px; background: var(--color-ink-raised); }
  .includes i { width: 8px; height: 8px; border-radius: 50%; background: var(--color-antidote); flex: none; }
  .otros { padding-block: 48px 72px; }
  .otros h2 { margin: 0 0 16px; }
  .otros ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin: 0; padding: 0; }
  .otros a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-size: 22px; text-decoration: none; }
  .otros a:hover { color: var(--color-antidote); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .photo { order: -1; } }
</style>
