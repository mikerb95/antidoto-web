---
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../CabeceraPagina.astro';
import { tp } from '../../i18n/paginas';
import { grafo, migasSchema } from '../../data/schema';
import WhatsappIcon from '../WhatsappIcon.astro';
import { obtenerServicios } from '../../data/servicios';
import { t, rutas, rutaPolitica, type Locale } from '../../i18n/ui';
import { SITE, waLink } from '../../data/site';
import { CONSENTIMIENTO, CONSENTIMIENTO_VERSION, NOVEDADES, NOVEDADES_VERSION } from '../../data/consentimiento';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const SERVICIOS = await obtenerServicios();
const c = s.cot;
const [title, description] = s.seo.contacto;
const migas: Array<[string, string]> = [
  [tp(locale).inicio, rutas.inicio[locale]],
  [s.nav.contacto, rutas.contacto[locale]],
];
// Con la API configurada en el build, el cotizador suma un paso de contacto y guarda el lead
// (con autorización) antes de abrir WhatsApp. Sin ella funciona como antes: solo WhatsApp.
const api = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
const pasos = api ? [c.pasos[0], c.pasos[1], c.pasoContacto, c.pasos[2]] : c.pasos;
const canales = [
  { k: s.canales.whatsapp, v: SITE.phoneDisplay, href: waLink(s.waDefault), externo: true },
  { k: s.canales.telefono, v: SITE.phoneDisplay, href: `tel:+${SITE.whatsapp}`, externo: false },
  { k: s.canales.correo, v: SITE.email, href: `mailto:${SITE.email}`, externo: false },
  { k: s.canales.instagram, v: '@antidoto.colombia', href: SITE.instagram, externo: true },
  { k: s.canales.linkedin, v: 'Antídoto Colombia', href: SITE.linkedin, externo: true },
];
---
<Base locale={locale} pagina="contacto" title={title} description={description} alternates={rutas.contacto} jsonLd={grafo(migasSchema(migas))} tema="claro">
  <CabeceraPagina locale={locale} migas={migas} titulo={s.contactoTitle} lead={s.contactoLead} />
  <section class="bloque" aria-label={s.contactoKicker}>
    <div class="wrap">

      <div class="bento">
        <!-- El cotizador necesita JS para armar el mensaje: el script lo muestra. Sin JS
             quedan visibles los canales directos. -->
        <form class="cotizador caja" hidden data-cotizador data-wa={SITE.whatsapp} data-api={api || undefined} novalidate aria-labelledby="cot-title">
          <div class="cot-top">
            <p class="mono mono-acento" id="cot-title">{c.titulo}</p>
            <p class="mono" aria-live="polite" data-paso-texto>{c.paso(1, pasos.length)}</p>
          </div>
          <div class="progreso" aria-hidden="true" style={`--pasos: ${pasos.length}`}>
            {pasos.map((p, i) => <span class:list={{ activo: i === 0 }} data-marca>{String(i + 1).padStart(2, '0')} · {p}</span>)}
            <span class="nivel"><span data-nivel></span></span>
          </div>

          <fieldset data-paso="1">
            <legend>{c.servicioPregunta}</legend>
            <div class="opciones">
              {SERVICIOS.map((sv, i) => (
                <label class="opcion">
                  <input type="radio" name="servicio" value={sv.id} data-titulo={sv[locale].title} />
                  <span class="mono mono-acento">0{i + 1}</span>
                  <span class="op-t">{sv[locale].title}</span>
                  <span class="op-d">{sv[locale].facts[0]}</span>
                </label>
              ))}
            </div>
            <p class="error" role="alert" hidden data-error>{c.elegir}</p>
          </fieldset>

          <fieldset data-paso="2" hidden>
            <legend>{c.pasos[1]}</legend>
            <div class="campos">
              <label>
                <span class="mono">{c.tipo}</span>
                <select name="tipo">
                  <option value="">·</option>
                  {c.tipos.map((tp) => <option value={tp}>{tp}</option>)}
                </select>
              </label>
              <label><span class="mono">{c.fecha} <em>({c.opcional})</em></span><input type="month" name="fecha" /></label>
              <label><span class="mono">{c.personas} <em>({c.opcional})</em></span><input type="number" name="personas" min="1" inputmode="numeric" /></label>
              <label><span class="mono">{c.ciudad} <em>({c.opcional})</em></span><input type="text" name="ciudad" autocomplete="address-level2" /></label>
            </div>
          </fieldset>

          {api && (
            <fieldset data-paso="contacto" hidden>
              <legend>{c.contactoLegend}</legend>
              <p class="resumen-lead">{c.contactoLead}</p>
              <div class="campos">
                <label><span class="mono">{c.nombre}</span><input type="text" name="nombre" autocomplete="name" maxlength="120" /></label>
                <label><span class="mono">{c.empresa} <em>({c.opcional})</em></span><input type="text" name="empresa" autocomplete="organization" maxlength="120" /></label>
                <label><span class="mono">{c.correo}</span><input type="email" name="email" autocomplete="email" maxlength="200" /></label>
                <label><span class="mono">{c.telefono}</span><input type="tel" name="telefono" autocomplete="tel" maxlength="40" /></label>
              </div>
              <!-- Trampa para bots: invisible y fuera del orden de tabulación. -->
              <label class="trampa" aria-hidden="true">Web<input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
              <div class="autorizo">
                <input type="checkbox" name="consentimiento" id="cot-autorizo" value={CONSENTIMIENTO_VERSION} />
                <label for="cot-autorizo">{CONSENTIMIENTO[locale]}</label>
              </div>
              <!-- Autorización aparte y opcional para recibir novedades (doble confirmación por correo). -->
              <div class="autorizo">
                <input type="checkbox" name="novedades" id="cot-novedades" value={NOVEDADES_VERSION} />
                <label for="cot-novedades">{NOVEDADES[locale]}</label>
              </div>
              <a class="politica" href={rutaPolitica[locale]} target="_blank">{c.verPolitica} ↗</a>
              <p class="error" role="alert" hidden data-error-contacto>{c.faltaContacto}</p>
            </fieldset>
          )}

          <fieldset data-paso="resumen" hidden>
            <legend>{pasos[pasos.length - 1]}</legend>
            <p class="resumen-lead">{c.resumenLead}</p>
            <pre class="resumen" data-resumen></pre>
          </fieldset>

          <div class="botones">
            <button type="button" class="boton boton-borde" data-atras hidden>← {c.anterior}</button>
            <button type="button" class="boton boton-tinta" data-siguiente>{c.siguiente} →</button>
            <a class="boton boton-cian" href="#" target="_blank" rel="noopener" data-enviar hidden><WhatsappIcon />{c.enviar}</a>
          </div>
          <p class="guardado" role="status" hidden data-guardado>{c.guardado}</p>
          <p class="privacidad mono">{api ? c.privacidadApi : c.privacidad}</p>
        </form>

        <aside class="canales caja" aria-labelledby="canales-title">
          <p class="mono mono-acento" id="canales-title">{s.canalesKicker}</p>
          <ul>
            {canales.map((cn) => (
              <li>
                <a href={cn.href} target={cn.externo ? '_blank' : undefined} rel={cn.externo ? 'noopener' : undefined}>
                  <span class="mono">{cn.k}</span>
                  <span class="v">{cn.v}</span>
                  <span class="flecha" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap, reducido } from '../../lib/motion/core';
  import { ui } from '../../i18n/ui';
  import { leerOrigen } from '../../lib/origen';

  // Cotizador por pasos. Arma el texto y abre WhatsApp con el mensaje listo (enlace real
  // wa.me, sin retardos). Si el build trae la API y la persona marca la autorización, además
  // guarda la solicitud: se envía con keepalive al hacer clic, sin frenar la apertura de
  // WhatsApp, y si la API falla no pasa nada visible (fail-open).
  const form = document.querySelector<HTMLFormElement>('[data-cotizador]');
  if (form) {
    const locale = document.documentElement.lang.startsWith('es') ? 'es' : 'en';
    const c = ui[locale].cot;
    const api = form.dataset.api;
    const pasos = [...form.querySelectorAll<HTMLFieldSetElement>('[data-paso]')];
    const marcas = [...form.querySelectorAll<HTMLElement>('[data-marca]')];
    const nivel = form.querySelector<HTMLElement>('[data-nivel]')!;
    const texto = form.querySelector<HTMLElement>('[data-paso-texto]')!;
    const atras = form.querySelector<HTMLButtonElement>('[data-atras]')!;
    const siguiente = form.querySelector<HTMLButtonElement>('[data-siguiente]')!;
    const enviar = form.querySelector<HTMLAnchorElement>('[data-enviar]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const errorContacto = form.querySelector<HTMLElement>('[data-error-contacto]');
    const guardado = form.querySelector<HTMLElement>('[data-guardado]')!;
    const resumen = form.querySelector<HTMLElement>('[data-resumen]')!;
    const inicio = Date.now();
    let actual = 0;
    let enviado = '';

    const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement | null;
    const valor = (n: string) => (campo(n)?.value ?? '').trim();
    const elegido = () => form.querySelector<HTMLInputElement>('input[name="servicio"]:checked');
    const autoriza = () => !!campo('consentimiento')?.checked;
    const fechaLegible = (v: string) => {
      if (!v) return '';
      const [a, m] = v.split('-').map(Number);
      return new Intl.DateTimeFormat(document.documentElement.lang, { month: 'long', year: 'numeric' }).format(new Date(a, m - 1, 1));
    };
    const mensaje = () => {
      const base = c.mensaje({ servicio: elegido()?.dataset.titulo ?? '', tipo: valor('tipo'), fecha: fechaLegible(valor('fecha')), personas: valor('personas'), ciudad: valor('ciudad') });
      if (!valor('nombre')) return base;
      const [primera, ...resto] = base.split('\n');
      return [primera, c.presentacion(valor('nombre'), valor('empresa')), ...resto].join('\n');
    };

    // Lo mismo que exige la API: nombre y un correo o teléfono con forma válida.
    const contactoValido = () => {
      const email = valor('email');
      const tel = valor('telefono').replace(/\D/g, '');
      const emailOk = !email || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      const telOk = !valor('telefono') || (tel.length >= 7 && tel.length <= 15);
      return valor('nombre').length >= 2 && (email || tel) && emailOk && telOk;
    };

    const ir = (n: number) => {
      actual = n;
      pasos.forEach((p, i) => (p.hidden = i !== n));
      marcas.forEach((m, i) => m.classList.toggle('activo', i <= n));
      texto.textContent = c.paso(n + 1, pasos.length);
      atras.hidden = n === 0;
      siguiente.hidden = n === pasos.length - 1;
      enviar.hidden = n !== pasos.length - 1;
      const escala = (n + 1) / pasos.length;
      if (reducido()) nivel.style.transform = `scaleX(${escala})`;
      else gsap.to(nivel, { scaleX: escala, duration: 0.6, ease: 'power3.out' });
      if (n === pasos.length - 1) {
        const m = mensaje();
        resumen.textContent = m;
        enviar.href = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(m)}`;
      }
      pasos[n].querySelector<HTMLElement>('input:not([tabindex="-1"]), select, a, button')?.focus({ preventScroll: true });
    };

    function guardarLead() {
      if (!api || !autoriza() || !contactoValido()) return;
      const cuerpo = JSON.stringify({
        servicio: elegido()?.value,
        tipo: valor('tipo'),
        fecha: valor('fecha'),
        personas: valor('personas'),
        ciudad: valor('ciudad'),
        nombre: valor('nombre'),
        empresa: valor('empresa'),
        email: valor('email'),
        telefono: valor('telefono'),
        mensaje: mensaje(),
        consentimiento: campo('consentimiento')!.value,
        // Novedades solo cuenta con correo: la API manda ahí la confirmación.
        novedades: campo('novedades')?.checked && valor('email') ? campo('novedades')!.value : undefined,
        web: valor('web'),
        locale,
        pagina: location.pathname,
        ...leerOrigen(),
        t: Date.now() - inicio,
      });
      // Un segundo clic con los mismos datos no duplica el lead.
      if (cuerpo.replace(/"t":\d+/, '') === enviado) return;
      enviado = cuerpo.replace(/"t":\d+/, '');
      // text/plain evita el preflight de CORS; keepalive deja terminar el envío aunque la
      // pestaña pierda el foco al abrir WhatsApp.
      fetch(`${api}/v1/leads`, { method: 'POST', body: cuerpo, keepalive: true, headers: { 'content-type': 'text/plain;charset=UTF-8' } })
        .then((r) => {
          if (r.ok) guardado.hidden = false;
        })
        .catch(() => {});
    }

    siguiente.addEventListener('click', () => {
      if (actual === 0 && !elegido()) {
        error.hidden = false;
        return;
      }
      if (pasos[actual].dataset.paso === 'contacto' && autoriza() && !contactoValido()) {
        errorContacto!.hidden = false;
        return;
      }
      error.hidden = true;
      if (errorContacto) errorContacto.hidden = true;
      ir(actual + 1);
    });
    atras.addEventListener('click', () => ir(actual - 1));
    enviar.addEventListener('click', guardarLead);
    form.addEventListener('change', () => {
      error.hidden = true;
      if (errorContacto) errorContacto.hidden = true;
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    // ?servicio=<clave> (desde el chat con IA) deja el servicio elegido.
    const pedido = new URLSearchParams(location.search).get('servicio');
    const opcion = [...form.querySelectorAll<HTMLInputElement>('input[name="servicio"]')].find((i) => i.value === pedido);
    if (opcion) opcion.checked = true;
    form.hidden = false;
    nivel.style.transform = `scaleX(${1 / pasos.length})`;
  }
</script>

<style>
  .bento { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .caja { border-radius: 24px; background: var(--color-paper); border: 1px solid var(--color-line-soft); box-shadow: 0 10px 30px rgb(15 24 29 / 0.06); }
  .mono { color: var(--color-slate); }
  .mono-acento { color: var(--color-deep); }
  .cotizador { padding: clamp(20px, 3vw, 32px); display: grid; gap: 20px; }
  .cotizador[hidden] { display: none; }
  .cot-top { display: flex; justify-content: space-between; gap: 12px; }
  .cot-top .mono { margin: 0; }
  .progreso { position: relative; display: grid; grid-template-columns: repeat(var(--pasos, 3), minmax(0, 1fr)); gap: 8px; padding-bottom: 14px; }
  .progreso > span[data-marca] { font: 600 11px var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-dash); }
  .progreso > span.activo { color: var(--color-deep); }
  .nivel { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; border-radius: 3px; background: var(--color-line-soft); overflow: hidden; }
  .nivel span { position: absolute; inset: 0; transform-origin: left; background: linear-gradient(90deg, var(--color-mid), var(--color-antidote)); }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  fieldset[hidden] { display: none; }
  legend { padding: 0; margin-bottom: 16px; font: 400 28px/1.15 var(--font-display); }
  .opciones { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .opcion { position: relative; display: grid; gap: 6px; padding: 18px; border-radius: 16px; border: 1.5px solid var(--color-line-input); background: var(--color-paper); cursor: pointer; transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out); }
  .opcion:hover { border-color: var(--color-mid); }
  .opcion:has(input:checked) { border-color: var(--color-deep); background: rgb(59 200 243 / 0.14); }
  .opcion:has(input:focus-visible) { outline: 2px solid var(--color-deep); outline-offset: 3px; }
  .opcion input { position: absolute; opacity: 0; pointer-events: none; }
  .op-t { font: 400 20px/1.15 var(--font-display); }
  .op-d { font-size: 14px; color: var(--color-slate); }
  .error { margin: 10px 0 0; color: #a23a1f; font-size: 14px; font-weight: 500; }
  .campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .campos label { display: grid; gap: 6px; }
  .campos em { font-style: normal; text-transform: none; letter-spacing: 0; opacity: 0.8; }
  input:not([type='radio']):not([type='checkbox']), select { min-height: 48px; padding: 0 14px; border-radius: 12px; border: 1.5px solid var(--color-line-input); background: var(--color-paper); color: var(--color-ink); font: 400 16px var(--font-sans); }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--color-deep); outline-offset: 2px; }
  .resumen-lead { margin: 0 0 12px; color: var(--color-slate); font-size: 15px; }
  .resumen { margin: 0; padding: 18px; border-radius: 14px; background: var(--color-mist); border: 1px solid var(--color-line-soft); font: 400 15px/1.6 var(--font-sans); white-space: pre-wrap; color: var(--color-ink); }
  .botones { display: flex; gap: 10px; flex-wrap: wrap; }
  .botones [hidden] { display: none; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .autorizo { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: start; margin-top: 14px; font-size: 14.5px; }
  .autorizo input { width: 22px; height: 22px; margin: 1px 0 0; accent-color: var(--color-deep); }
  .autorizo label { cursor: pointer; }
  .politica { display: inline-flex; align-items: center; min-height: 44px; margin-left: 34px; font-size: 14px; color: var(--color-deep); }
  .guardado { margin: 0; color: var(--color-deep); font-size: 15px; font-weight: 500; }
  .guardado[hidden] { display: none; }
  .privacidad { margin: 0; text-transform: none; letter-spacing: 0.01em; font-size: 12.5px; font-weight: 500; }

  .canales { padding: 24px; display: grid; gap: 12px; }
  .canales > .mono { margin: 0; }
  .canales ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .canales a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; padding: 12px 0; min-height: 44px; border-top: 1px solid var(--color-line-soft); text-decoration: none; color: var(--color-ink); }
  .canales li:first-child a { border-top: 0; }
  .canales a .mono { grid-column: 1; }
  .canales .v { grid-column: 1; font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
  .canales .flecha { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--color-deep); }
  .canales a:hover .v { color: var(--color-deep); }

  @media (max-width: 900px) { .bento { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .opciones, .campos { grid-template-columns: 1fr; } .progreso > span[data-marca] { font-size: 9.5px; } }
</style>
