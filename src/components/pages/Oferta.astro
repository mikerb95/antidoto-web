---
// Subpágina de una oferta dentro de su línea (p. ej. Producción audiovisual > Planes de
// emergencia): para quién, qué incluye, detalle, áreas para las que se recomienda, otras ofertas
// de la línea, preguntas de la línea y cotización con el servicio ya elegido.
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CabeceraPagina from '../CabeceraPagina.astro';
import TarjetaIndice from '../TarjetaIndice.astro';
import ListaFaq from '../ListaFaq.astro';
import BloqueCta from '../BloqueCta.astro';
import WhatsappIcon from '../WhatsappIcon.astro';
import { servicioPath, type Servicio } from '../../data/servicios';
import { obtenerOfertas, ofertaPath, type Oferta } from '../../data/contenido';
import { SOLUCIONES, solucionPath } from '../../data/soluciones';
import { preguntas, TEMAS_FAQ, type TemaFaq } from '../../data/faq';
import { t, rutas, type Locale } from '../../i18n/ui';
import { tp } from '../../i18n/paginas';
import { waLink } from '../../data/site';
import { ogRuta } from '../../lib/og-rutas';
import { grafo, migasSchema, ofertaSchema, faqSchema } from '../../data/schema';

interface Props {
  locale: Locale;
  linea: Servicio;
  oferta: Oferta;
}
const { locale, linea, oferta } = Astro.props;
const s = t(locale);
const p = tp(locale);
const txt = oferta[locale];
const lineaTxt = linea[locale];
const msg = p.oferta.wa(txt.title, lineaTxt.title);
const hermanas = (await obtenerOfertas(linea.id)).filter((o) => o.id !== oferta.id);
const soluciones = SOLUCIONES.filter((sol) => sol.ofertas.includes(oferta.id));
const tema = (TEMAS_FAQ as readonly string[]).includes(linea.id) ? (linea.id as TemaFaq) : undefined;
const faq = tema ? preguntas(locale, { tema }) : [];

const entrada = txt.entrada ? await getEntry('ofertas', txt.entrada) : undefined;
const { Content } = entrada?.body?.trim() ? await render(entrada) : { Content: undefined };

const ruta = ofertaPath(linea, oferta, locale);
const migas: Array<[string, string]> = [
  [p.inicio, rutas.inicio[locale]],
  [s.nav.servicios, rutas.servicios[locale]],
  [lineaTxt.title, servicioPath(linea, locale)],
  [txt.title, ruta],
];
const jsonLd = grafo(
  ofertaSchema({ nombre: txt.title, descripcion: txt.lead, ruta, linea: lineaTxt.title, rutaLinea: servicioPath(linea, locale) }, locale),
  migasSchema(migas),
  ...(faq.length ? [faqSchema(faq)] : []),
);
const perfiles = s.inicio.paraQuien.perfiles;
---
<Base
  locale={locale}
  pagina="servicios"
  title={`${txt.title} | ${lineaTxt.title} | Antídoto`}
  description={txt.lead}
  alternates={{ es: ofertaPath(linea, oferta, 'es'), en: ofertaPath(linea, oferta, 'en') }}
  waMessage={msg}
  jsonLd={jsonLd}
  og={{ ruta: ogRuta('oferta', oferta.id, locale), alt: `${txt.title}, ${lineaTxt.title} | Antídoto` }}
  scroll="suave"
>
  <CabeceraPagina locale={locale} migas={migas} kicker={lineaTxt.title} titulo={txt.title} lead={txt.lead} imagen={linea.image} alt={lineaTxt.alt} vt={`oferta-${oferta.id}-title`}>
    <a class="boton boton-cian boton-grande" href={`${rutas.contacto[locale]}?servicio=${linea.id}&oferta=${oferta.id}`} data-magnetico>{p.oferta.cotizarEsta}</a>
    <a class="boton boton-borde boton-grande" href={waLink(msg)} target="_blank" rel="noopener"><WhatsappIcon />WhatsApp</a>
    {txt.para.length > 0 && (
      <p class="para" slot="pie"><span>{p.oferta.para}:</span>{txt.para.map((x) => <span class="chip">{x}</span>)}</p>
    )}
  </CabeceraPagina>

  <section class="bloque" aria-labelledby="incluye-t">
    <div class="wrap dos">
      <div class="cab-izq">
        <h2 id="incluye-t">{p.oferta.incluye[0]}<span class="resaltado">{p.oferta.incluye[1]}</span></h2>
      </div>
      <div class="contenido">
        {txt.incluye.length > 0 ? (
          <ul class="incluye" data-entra>
            {txt.incluye.map((x) => (
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg><span>{x}</span></li>
            ))}
          </ul>
        ) : (
          <p class="pendiente">{p.oferta.incluyePendiente}</p>
        )}
        {Content ? <div class="prosa"><Content /></div> : <p class="pendiente">{p.oferta.detallePendiente}</p>}
        <p class="pendiente">{p.oferta.fotosPendiente}</p>
      </div>
    </div>
  </section>

  {soluciones.length > 0 && (
    <section class="bloque bloque-mist" aria-labelledby="para-t">
      <div class="wrap">
        <div class="cab-izq">
          <h2 id="para-t">{p.oferta.soluciones[0]}<span class="resaltado">{p.oferta.soluciones[1]}</span></h2>
        </div>
        <ul class="rejilla-tarjetas" data-entra>
          {soluciones.map((sol) => (
            <li><TarjetaIndice href={solucionPath(sol, locale)} titulo={perfiles[sol.perfil][0]} texto={perfiles[sol.perfil][1]} cta={s.inicio.paraQuien.verSoluciones} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hermanas.length > 0 && (
    <section class="bloque" aria-labelledby="hermanas-t">
      <div class="wrap">
        <div class="cab-izq">
          <h2 id="hermanas-t">{p.oferta.otras(lineaTxt.title)}</h2>
        </div>
        <ul class="rejilla-tarjetas" data-entra>
          {hermanas.map((o) => (
            <li><TarjetaIndice href={ofertaPath(linea, o, locale)} titulo={o[locale].title} texto={o[locale].lead} cta={p.linea.verOferta} vt={`oferta-${o.id}-title`} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="bloque bloque-mist" aria-labelledby="faq-t">
      <div class="wrap dos">
        <div class="cab-izq">
          <h2 id="faq-t">{p.linea.faq[0]}<span class="resaltado">{p.linea.faq[1]}</span></h2>
          <a class="mas" href={rutas.faq[locale]}>{p.faq.todas}</a>
        </div>
        <ListaFaq items={faq} />
      </div>
    </section>
  )}

  <BloqueCta locale={locale} servicio={linea.id} oferta={oferta.id} mensaje={msg} />
</Base>

<style>
  .para { margin: 8px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--color-slate); }
  .chip { padding: 6px 12px; border-radius: 999px; background: var(--color-paper); border: 1px solid var(--color-line-soft); color: var(--color-ink); font-weight: 500; }
  .dos { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px; align-items: start; }
  .contenido { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .contenido .pendiente { justify-content: flex-start; text-align: left; }
  .incluye { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); gap: 12px; }
  .incluye li { display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border-radius: 16px; background: var(--color-mist); font-weight: 500; }
  .incluye svg { width: 20px; height: 20px; flex: none; margin-top: 2px; fill: none; stroke: var(--color-mid); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .mas { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; color: var(--color-deep); font-weight: 600; }
  @media (max-width: 900px) { .dos { grid-template-columns: 1fr; gap: 0; } }
</style>
