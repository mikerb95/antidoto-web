---
// Home rediseñada (antidoto-home-diseno/home.html): base clara con secciones oscuras.
// La nav y el pie son los del layout; aquí van las diez secciones del cuerpo, en orden.
import Base from '../../layouts/Base.astro';
import Hero from '../home/Hero.astro';
import ClientesCifras from '../home/ClientesCifras.astro';
import Dolores from '../home/Dolores.astro';
import Pasos from '../home/Pasos.astro';
import Servicios from '../home/Servicios.astro';
import Actividades from '../home/Actividades.astro';
import ParaQuien from '../home/ParaQuien.astro';
import Equipo from '../home/Equipo.astro';
import Faq from '../home/Faq.astro';
import Cierre from '../home/Cierre.astro';
import { t, rutas, type Locale } from '../../i18n/ui';
import { organizationSchema } from '../../data/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const [title, description] = t(locale).seo.inicio;
---
<Base locale={locale} pagina="inicio" title={title} description={description} alternates={rutas.inicio} jsonLd={organizationSchema()} tema="claro">
  <Hero locale={locale} />
  <ClientesCifras locale={locale} />
  <Dolores locale={locale} />
  <Pasos locale={locale} />
  <Servicios locale={locale} />
  <Actividades locale={locale} />
  <ParaQuien locale={locale} />
  <Equipo locale={locale} />
  <Faq locale={locale} />
  <Cierre locale={locale} />
</Base>
