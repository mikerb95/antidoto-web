---
import Base from '../../layouts/Base.astro';
import Encabezado from '../Encabezado.astro';
import Retos from '../Retos.astro';
import ContactoCta from '../ContactoCta.astro';
import { t, rutas, type Locale } from '../../i18n/ui';
import { SITE } from '../../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const [title, description] = s.seo.nosotros;
const hud: Array<[string, string]> = [
  ['base', s.hud.base],
  ['mezcla', s.hud.mezcla],
  ['reaccion', s.hud.reaccion],
  ['dosis', s.hud.dosis],
];
const datos = locale === 'es'
  ? [['Formación', 'Ingeniería civil'], ['Especialización', 'Gerencia de SST'], ['Fundada', String(SITE.foundingYear)], ['Idiomas', 'Español, portugués e inglés']]
  : [['Degree', 'Civil engineering'], ['Specialization', 'Health and safety management'], ['Founded', String(SITE.foundingYear)], ['Languages', 'Spanish, Portuguese and English']];
---
<Base locale={locale} pagina="nosotros" title={title} description={description} alternates={rutas.nosotros} scroll="suave" hud={hud}>
  <section class="seccion" data-hud="base" aria-labelledby="pagina-title">
    <div class="wrap">
      <Encabezado num="01" kicker={s.nosotrosKicker} titulo={s.nosotrosTitle} lead={s.nosotrosLead} id="pagina-title" nivel={1} />

      <div class="bento">
        <article class="fundadora panel" aria-labelledby="fundadora-nombre">
          <div class="retrato" aria-hidden="true">
            <span class="iniciales">MP</span>
            <span class="mono pendiente">{s.fotoPendiente}</span>
          </div>
          <div class="bio">
            <p class="mono mono-acento">{s.fundadoraKicker}</p>
            <h2 id="fundadora-nombre">{s.fundadoraNombre}</h2>
            <p class="cargo">{s.fundadoraCargo}</p>
            <p>{s.fundadoraBio}</p>
          </div>
        </article>
        <dl class="datos panel">
          {datos.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="seccion" data-hud="mezcla" aria-labelledby="historia-title">
    <div class="wrap">
      <Encabezado num="02" kicker={s.historiaKicker} titulo={s.historiaTitle} id="historia-title" />
      <div class="linea-caja" data-historia>
      <span class="riel" aria-hidden="true"><span class="lleno" data-riel></span></span>
      <ol class="linea">
        {s.historia.map(([anio, titulo, texto], i) => (
          <li class="hito" data-hito>
            <span class="nodo" aria-hidden="true"></span>
            <p class="anio">{anio}</p>
            <h3>{titulo}</h3>
            <p class="texto">{texto}</p>
            <span class="mono estado">{i < s.historia.length - 1 ? '✓' : '●'}</span>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <Retos locale={locale} num="03" />
  <ContactoCta locale={locale} num="04" />
</Base>

<script>
  import { gsap, pieza } from '../../lib/motion/core';

  // La línea de tiempo se llena con el scroll como el nivel del frasco y cada hito se
  // enciende al alcanzarlo. El HTML trae la línea llena: el script parte de vacío.
  const raiz = document.querySelector<HTMLElement>('[data-historia]');
  if (raiz) {
    pieza('historia', () => {
      const lleno = raiz.querySelector<HTMLElement>('[data-riel]')!;
      const hitos = [...raiz.querySelectorAll<HTMLElement>('[data-hito]')];
      const vertical = matchMedia('(max-width: 760px)').matches;
      gsap.fromTo(lleno, vertical ? { scaleY: 0 } : { scaleX: 0 }, {
        ...(vertical ? { scaleY: 1 } : { scaleX: 1 }),
        ease: 'none',
        scrollTrigger: {
          trigger: raiz,
          start: 'top 75%',
          end: 'bottom 55%',
          scrub: 0.5,
          onUpdate: (st) => hitos.forEach((h, i) => h.classList.toggle('is-alcanzado', st.progress >= i / (hitos.length - 1) - 0.02)),
        },
      });
      hitos.forEach((h) => h.classList.add('is-pendiente'));
    }, () => raiz.querySelectorAll('[data-hito]').forEach((h) => h.classList.remove('is-pendiente')));
  }
</script>

<style>
  .bento { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 12px; margin-top: 36px; }
  .fundadora { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 24px; padding: 24px; }
  .retrato { position: relative; aspect-ratio: 1; border-radius: 16px; display: grid; place-items: center; background: radial-gradient(circle at 30% 20%, rgb(59 200 243 / 0.35), rgb(12 92 125 / 0.5) 60%, rgb(10 17 21 / 0.9)); border: 1px solid rgb(128 220 255 / 0.2); overflow: hidden; }
  .iniciales { font: 400 64px/1 var(--font-display); color: var(--color-fg); }
  .pendiente { position: absolute; bottom: 10px; left: 0; right: 0; text-align: center; font-size: 9.5px; }
  .bio .mono { margin: 0 0 8px; }
  .bio h2 { margin: 0; font-size: clamp(28px, 1.6vw + 16px, 40px); line-height: 1.05; }
  .cargo { margin: 4px 0 14px; color: var(--color-antidote); font-weight: 500; }
  .bio p:last-child { margin: 0; color: var(--color-fg-muted); }
  .datos { margin: 0; padding: 20px 24px; display: grid; align-content: center; }
  .datos div { padding: 12px 0; border-top: 1px solid var(--color-line); }
  .datos div:first-child { border-top: 0; }
  dt { margin: 0 0 2px; }
  dd { margin: 0; font-size: 16px; }

  .linea-caja { position: relative; margin-top: 40px; }
  .linea { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .riel { position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: rgb(128 220 255 / 0.14); }
  .lleno { position: absolute; inset: 0; background: linear-gradient(90deg, var(--color-mid), var(--color-antidote)); transform-origin: left center; box-shadow: 0 0 12px rgb(59 200 243 / 0.6); }
  .hito { position: relative; padding-top: 34px; }
  .nodo { position: absolute; top: 0; left: 0; width: 16px; height: 16px; border-radius: 50%; background: var(--color-ink); border: 2px solid var(--color-antidote); transition: background var(--t-base) var(--ease-out), box-shadow var(--t-base) var(--ease-out); }
  .anio { margin: 0; font: 400 44px/1 var(--font-accent); color: var(--color-antidote); }
  .hito h3 { margin: 10px 0 6px; font-size: 20px; line-height: 1.15; }
  .texto { margin: 0; font-size: 14px; color: var(--color-fg-muted); }
  .estado { display: block; margin-top: 10px; color: var(--color-antidote); }
  .hito:global(.is-pendiente) .nodo { background: var(--color-ink); }
  .hito:global(.is-pendiente) .anio { color: var(--color-fg-muted); }
  .hito:global(.is-pendiente.is-alcanzado) .nodo { background: var(--color-antidote); box-shadow: 0 0 14px var(--color-antidote); }
  .hito:global(.is-pendiente.is-alcanzado) .anio { color: var(--color-antidote); }
  .hito .anio { transition: color var(--t-base) var(--ease-out); }

  @media (max-width: 900px) {
    .bento { grid-template-columns: 1fr; }
    .fundadora { grid-template-columns: 120px minmax(0, 1fr); }
    .iniciales { font-size: 40px; }
  }
  @media (max-width: 760px) {
    .linea { grid-template-columns: 1fr; gap: 28px; padding-left: 32px; }
    .linea-caja { margin-top: 32px; }
    .riel { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .lleno { transform-origin: center top; background: linear-gradient(180deg, var(--color-mid), var(--color-antidote)); }
    .hito { padding-top: 0; }
    .nodo { left: -32px; top: 4px; }
  }
  @media (max-width: 480px) { .fundadora { grid-template-columns: 1fr; } .retrato { max-width: 140px; } }
</style>
