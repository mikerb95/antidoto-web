---
import WhatsappIcon from './WhatsappIcon.astro';
import { t, type Locale } from '../i18n/ui';
import { waLink } from '../data/site';

interface Props {
  locale: Locale;
  message?: string;
}
const { locale, message } = Astro.props;
const s = t(locale);
---
<div class="mbar" data-mbar>
  <a class="btn btn-primary" href={waLink(message ?? s.waDefault)} target="_blank" rel="noopener"><WhatsappIcon />{s.heroCta}</a>
</div>

<script>
  // La barra aparece al pasar el hero y se oculta cuando el contacto o el footer están en pantalla.
  function init() {
    const bar = document.querySelector<HTMLElement>('[data-mbar]');
    if (!bar) return;
    const hide = new Set<Element>();
    const targets = document.querySelectorAll('[data-hero], #contacto, footer');
    if (!targets.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? hide.add(e.target) : hide.delete(e.target)));
      bar.classList.toggle('is-hidden', hide.size > 0);
    });
    targets.forEach((el) => io.observe(el));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--color-ink-deep) 92%, transparent);
      backdrop-filter: blur(8px); border-top: 1px solid var(--color-line);
      transition: transform var(--t-base) var(--ease-out);
    }
    .mbar .btn { width: 100%; }
    .mbar:global(.is-hidden) { transform: translateY(110%); }
  }
</style>
