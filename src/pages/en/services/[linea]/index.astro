---
import type { GetStaticPaths } from 'astro';
import Servicio from '../../../../components/pages/Servicio.astro';
import { obtenerServicios } from '../../../../data/servicios';

export const getStaticPaths = (async () =>
  (await obtenerServicios()).map((servicio) => ({ params: { linea: servicio.en.slug }, props: { servicio } }))) satisfies GetStaticPaths;

const { servicio } = Astro.props;
---
<Servicio locale="en" servicio={servicio} />
