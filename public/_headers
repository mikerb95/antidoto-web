# Solo aplica en Cloudflare Pages (vista previa). En Hostinger este archivo se ignora.
# Evita que Google indexe las URLs de vista previa *.pages.dev.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Service worker y manifest: siempre revalidados.
/sw.js
  Cache-Control: no-cache
/site.webmanifest
  Cache-Control: no-cache
