# Configuración para Hostinger (Apache / LiteSpeed). Traduce la config nginx de auditoria/01-auditoria-tecnica.md §3.

Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html

# HTTPS y dominio sin www (301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://antidotocolombia.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Origin-Agent-Cluster "?1"
  # Empieza en Report-Only: revisar la consola antes de pasarla a Content-Security-Policy.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://api.antidotocolombia.com https://*.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.antidotocolombia.com https://*.workers.dev; object-src 'none'; frame-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Compresión (LiteSpeed además sirve brotli por su cuenta)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
# robots.txt y llms.txt llevan tildes
AddCharset utf-8 .txt

# Caché: assets con hash inmutables, HTML siempre revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # El service worker y el manifest se revalidan siempre: así cada despliegue llega a quien ya instaló el sitio.
  <FilesMatch "^(sw\.js|site\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteRule ^_astro/ - [E=ASTRO_ASSET:1]
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
</IfModule>
